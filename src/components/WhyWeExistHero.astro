---
/**
 * WhyWeExistHero — production hero for /our-approach.
 *
 * Wraps the sandbox-validated WhyWeExistTwoActs component in a pinned,
 * scroll-driven animation:
 *
 *   • Section is 200vh tall; inner container is sticky 100vh.
 *   • As the user scrolls through that 100vh:
 *       - Stage 1 (artifacts + "too many handoffs" header) drifts UP
 *         and fades out.
 *       - Stage 2 (Customer-360 dashboard + "nothing falls through"
 *         header) slides UP from bottom-center and fades in.
 *       - The two headers crossfade between 0.3 → 0.7 progress so
 *         the headline change reads as the centerpiece.
 *
 * The sandbox component's .ww-bridge ("Pulled together") and
 * .ww-caption ("One team · One schedule · One bill") are hidden in
 * hero mode — they only made sense in the static stacked sandbox
 * preview.
 *
 * Hero mode is opt-in: applying the .ww-hero wrapper around
 * WhyWeExistTwoActs is what triggers the absolute-positioning
 * overrides below. The component itself stays a pure render of
 * "stage 1 + bridge + stage 2"; this file repositions everything.
 */

import WhyWeExistTwoActs from './experiments/WhyWeExistTwoActs.astro';
---

<section class="ww-hero oa-section" id="problem" data-next-label="Our story">
  <div class="ww-hero__pin" data-ww-hero-pin>
    <WhyWeExistTwoActs />
  </div>
</section>

<script>
  /**
   * Scroll-driven animation for the WhyWeExistHero.
   *
   * Wires GSAP ScrollTrigger to a single pin on the section, then
   * uses onUpdate to drive transforms on the two stages and the
   * two headers based on a 0→1 progress value.
   *
   * Why onUpdate (not a tweened timeline)?
   *   - We're scrubbing scroll position 1:1 to the animation.
   *   - The animation is short (one viewport) and doesn't need
   *     multiple keyframes — explicit math is more legible than
   *     gsap.timeline() with .to() chains for this case.
   *
   * The stage and header elements are queried after DOM ready, so
   * we wait for window load to make sure the WhyWeExistTwoActs
   * component has fully rendered (its inner fit-script also runs
   * after layout).
   */
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const hero = document.querySelector('.ww-hero');
    if (!hero) return;
    const pin = hero.querySelector('[data-ww-hero-pin]');
    const root = hero.querySelector('.ww-root');
    if (!pin || !root) return;

    // Sync --ww-site-nav to the distance between document top and the
    // hero's natural top (= space taken up by site header + any
    // banners / spacing above it). The hero's height calcs subtract
    // this once for the TOP buffer (so stages start below the sticky
    // nav once pinned) and once for the BOTTOM buffer (so before the
    // pin engages — when section.top is still that-many-px below
    // viewport top — the stage doesn't overflow the visible area).
    const heroEl = hero as HTMLElement;
    const heroTopFromDoc = heroEl.getBoundingClientRect().top + window.scrollY;
    heroEl.style.setProperty('--ww-site-nav', `${Math.max(0, Math.round(heroTopFromDoc))}px`);

    const headerBad = root.querySelector('[data-ww-header="bad"]');
    const headerGood = root.querySelector('[data-ww-header="good"]');
    const stage1 = root.querySelector('.ww-stage-shell');
    const stage2 = root.querySelector('.ww-shell');

    if (!headerBad || !headerGood || !stage1 || !stage2) return;

    // Initial state — set explicitly so first-paint matches what
    // ScrollTrigger will compute on first onUpdate.
    headerBad.style.opacity = '1';
    headerGood.style.opacity = '0';
    stage1.style.transform = 'translate(-50%, 0) scale(1)';
    stage1.style.opacity = '1';
    stage2.style.transform = 'translate(-50%, 100vh)';
    stage2.style.opacity = '0';

    ScrollTrigger.create({
      trigger: hero,
      // Pin engages the moment the user lands on the page. Without
      // this, the user has to scroll past the site nav (~104px) before
      // the pin activates — which would let the hero header scroll up
      // out of view briefly before snapping back.
      // 'top top+=heroTop' fires when the section's top hits its own
      // natural document offset (= scrollY 0 since section.top equals
      // heroTopFromDoc at scroll=0).
      start: () => `top top+=${heroEl.getBoundingClientRect().top + window.scrollY}`,
      end: '+=100%',
      pin: pin,
      pinSpacing: true,
      // anticipatePin: 1 — preempts the position:fixed switch right
      // before the trigger reaches the top. Without it, ScrollTrigger
      // computes the transition synchronously the first time the user
      // scrolls into the pin range, which appears as a brief "stick"
      // before the pin engages. Especially noticeable when combined
      // with Lenis smoothed scroll.
      anticipatePin: 1,
      scrub: 0.4,
      // fastScrollEnd: true — when the user scrolls fast then stops
      // or reverses direction, snap the animation to the current
      // scroll position instead of slowly winding back through the
      // scrub buffer. Removes the "drag" on direction change.
      fastScrollEnd: true,
      onUpdate: (self) => {
        const p = self.progress;

        // --- Stage 1 (artifacts) — drift up and fade out -----------
        // Stays mostly put until p=0.1, then accelerates upward and
        // fades. By p=0.7 it's gone.
        const s1 = Math.max(0, (p - 0.1) / 0.6);
        const s1Y = -s1 * 60; // up to 60vh upward
        const s1Scale = 1 - s1 * 0.05; // very slight zoom-out
        stage1.style.transform = `translate(-50%, ${s1Y}vh) scale(${s1Scale})`;
        stage1.style.opacity = String(Math.max(0, 1 - s1 * 1.4));

        // --- Stage 2 (dashboard) — slide up from bottom -----------
        // Most of the rise happens between p=0.3 and p=0.85 so the
        // dashboard "lands" before the user finishes scrolling.
        const s2Rise = Math.min(1, p / 0.85);
        const s2Y = (1 - s2Rise) * 100; // 100vh → 0
        stage2.style.transform = `translate(-50%, ${s2Y}vh)`;
        stage2.style.opacity = String(Math.min(1, p * 1.3));

        // --- Headers — crossfade in the middle window 0.3 → 0.7 ---
        const headerP = Math.max(0, Math.min(1, (p - 0.3) / 0.4));
        headerBad.style.opacity = String(1 - headerP);
        headerGood.style.opacity = String(headerP);
      },
    });
  }

  // Run after the WhyWeExistTwoActs inner script has set canvas scales.
  if (document.readyState === 'complete') {
    initHero();
  } else {
    window.addEventListener('load', initHero, { once: true });
  }
</script>

<style is:global>
  /* ====================================================================
     WhyWeExistHero — hero-mode overrides for WhyWeExistTwoActs.
     The sandbox component is designed to render as a static stacked
     page (header → artifacts → bridge → header → dashboard → caption).
     Inside .ww-hero we re-arrange it so both stages occupy the same
     viewport, then the JS slides them past each other on scroll.
     ==================================================================== */

  .ww-hero {
    /* Layout tokens — these reserve fixed-height bands inside the
       pinned viewport so the header always has padding to the artifacts
       below, and the artifacts can never overflow the viewport.
         --ww-site-nav:    height of the sticky site nav above the
                           hero. Reserved at the TOP of the pin so the
                           hero header isn't hidden behind the nav once
                           the pin activates. Also reserved at the
                           BOTTOM of the pin so before the pin engages
                           (when section.top is still 64px below
                           viewport top), the stage doesn't overflow
                           the visible area.
         --ww-edge-pad:    breathing room at top/bottom of pin.
         --ww-header-zone: vertical band reserved for kicker + headline
                           + subhead — large enough for 2-line headline
                           + 2-line subhead at desktop type sizes.
         --ww-stage-pad:   gap between bottom of header band and top of
                           the stage canvas.
       Using clamp() so they scale gracefully between phone and desktop. */
    --ww-site-nav: 64px;
    --ww-edge-pad: clamp(12px, 2vh, 28px);
    --ww-header-zone: clamp(150px, 22vh, 200px);
    --ww-stage-pad: clamp(16px, 3vh, 32px);

    /* 200vh tall: 100vh of "pin scroll" room + section reveal. */
    position: relative;
    height: 200vh;
    /* Match the sandbox's dark gradient so the section looks the same
       at rest as it did in the sandbox preview. */
    background: radial-gradient(ellipse at 50% 30%, #0c4a6e 0%, #0a1929 70%);
    color: #fff;
    overflow: clip;
  }
  .ww-hero__pin {
    /* The actual viewport-sized container that ScrollTrigger pins. */
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  /* Strip .ww-root of its sandbox decorations — its width, padding,
     bg and overflow are all already covered by the parent .ww-hero. */
  .ww-hero .ww-root {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    overflow: visible;
    position: relative;
  }

  /* Hide the sandbox-only bridge and caption — they made sense only
     in the static stacked layout. */
  .ww-hero .ww-bridge,
  .ww-hero .ww-caption {
    display: none !important;
  }

  /* === Headers — pinned in the top header zone, both stacked, JS
       controls opacity for crossfade. The header zone has a fixed
       height that the stage will never enter.
       The pin element is locked at viewport y=site_nav (right below
       the sticky site nav), so content positions inside the pin start
       from pin coord y=0 — no need to add the site_nav as a buffer
       inside the pin's coordinate system. ============= */
  .ww-hero .ww-header {
    position: absolute;
    top: var(--ww-edge-pad);
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    max-width: 820px;
    height: var(--ww-header-zone);
    margin: 0;
    z-index: 5;
    pointer-events: none;
    will-change: opacity;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  /* Hide the "good" header by default — both headers are absolutely
     positioned at the same spot, and without this they'd render
     overlapping at opacity 1 between first paint and when the JS
     scroll handler initializes (which fires on window.load). The JS
     animates this opacity up during the scroll crossfade. */
  .ww-hero [data-ww-header="good"] {
    opacity: 0;
  }

  /* === Stage 1 — artifacts canvas, lives BELOW the header zone =====
     Override the sandbox's aspect-ratio so the shell is sized to the
     available viewport space instead. The fit script in
     WhyWeExistTwoActs.astro considers BOTH shell width AND shell
     height when computing scale, so the inner 1280×680 wrap shrinks
     uniformly until it fits both dimensions.
     Height calc subtracts --ww-site-nav once: the pin sits at viewport
     y=site_nav (locked there from page load), so the visible window
     inside the pin = 100vh - site_nav. ============= */
  .ww-hero .ww-stage-shell {
    position: absolute;
    left: 50%;
    top: calc(var(--ww-edge-pad) + var(--ww-header-zone) + var(--ww-stage-pad));
    width: min(94%, 1180px);
    height: calc(100vh
      - var(--ww-site-nav)
      - var(--ww-edge-pad) * 2
      - var(--ww-header-zone)
      - var(--ww-stage-pad));
    /* Cap so we don't scale past the design's natural canvas height. */
    max-height: 580px;
    margin: 0;
    /* Override the sandbox's aspect-ratio: 1280 / 680 — height now wins. */
    aspect-ratio: auto;
    transform: translate(-50%, 0);
    transform-origin: center top;
    will-change: transform, opacity;
  }

  /* Center the inner 1280×680 wrap within the shell. Its scale is
     controlled by --ww-s (set by fit()); we just need to keep the
     scaled rect centered in the shell so a width- or height-bound
     scale doesn't leave it stuck in the top-left corner. */
  .ww-hero .ww-stage-shell .ww-stage-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: center;
    transform: translate(-50%, -50%) scale(var(--ww-s, 1));
  }

  /* === Stage 2 — dashboard window, mirror of Stage 1 — same height
       budget, overrides aspect-ratio: 1280/740 from sandbox. ======= */
  .ww-hero .ww-shell {
    position: absolute;
    left: 50%;
    top: calc(var(--ww-edge-pad) + var(--ww-header-zone) + var(--ww-stage-pad));
    width: min(94%, 1180px);
    height: calc(100vh
      - var(--ww-site-nav)
      - var(--ww-edge-pad) * 2
      - var(--ww-header-zone)
      - var(--ww-stage-pad));
    max-height: 580px;
    margin: 0;
    aspect-ratio: auto;
    transform: translate(-50%, 100vh);
    opacity: 0;
    will-change: transform, opacity;
  }
  .ww-hero .ww-shell .ww-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    transform-origin: center;
    transform: translate(-50%, -50%) scale(var(--ww-s, 1));
  }

  /* === Mobile (≤900px) — switch to a portrait canvas (400×880) and
       rearrange the 9 artifact cards top-to-bottom so they fill the
       narrow viewport's available height instead of leaving a tiny
       horizontal band of stuff. WhyWeExistTwoActs.astro's own 900px
       media query collapses the canvas into a stacked single-column
       grid (which breaks the hero's pinned-stage choreography); these
       overrides restore an absolute-positioned canvas inside .ww-hero
       at mobile-friendly dimensions, and the fit() script reads the
       new offsetWidth/Height to compute --ww-s accordingly.
       Several rules need !important because the sandbox component
       uses !important on .ww-art's mobile reset. ============= */
  @media (max-width: 900px) {
    /* Mobile-only header-zone override. The default clamp(150, 22vh, 200)
       gives ~179px on a 812-tall iPhone, but the 3-line wrapped
       subtitle ("Maintenance, repairs, communication, and billing
       usually live in different places — or fall through the cracks
       entirely.") needs ~230px. Bumping the zone pushes the stages
       down so they no longer overlap the subtitle. The stage-shell
       height calc subtracts this once, so the canvas shrinks by the
       same amount — Stage 1's portrait artifacts and Stage 2's phone
       both stay visible. */
    .ww-hero {
      --ww-header-zone: clamp(210px, 30vh, 260px);
    }

    /* Act 1 — artifacts canvas: 2-column 480×720 portrait-leaning frame.
       Aspect (0.67) is close to the mobile shell's ~0.72 so the
       fit() script's --ww-s ends up around 0.68 — much bigger than
       the original 1280-wide canvas would have given (~0.28) — and
       both axes get used. Width 480 buys room for two ~200px columns
       of cards with a center-bridge photo. */
    .ww-hero .ww-stage-shell .ww-stage-wrap {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 480px;
      height: 720px;
      margin: 0;
      display: block;
      gap: 0;
      transform-origin: center;
      transform: translate(-50%, -50%) scale(var(--ww-s, 1));
    }
    .ww-hero .ww-stage {
      display: block;
      position: relative;
      width: 100%;
      height: 100%;
    }
    /* Hide the dashed connectors on mobile — their SVG paths are
       drawn for the desktop layout's artifact positions, so they
       would point to wrong places after the rearrangement. */
    .ww-hero .ww-connectors { display: none; }
    .ww-hero .ww-art {
      position: absolute !important;
      width: auto !important;
      margin: 0 !important;
    }
    /* 2-column layout: left col x≈10–235, right col x≈245–475,
       with a wider photo straddling the middle as a bridge.
       Cards alternate slight rotations for the pinboard feel. */
    /* Left column: text → note → cal → invoice */
    .ww-hero .ww-art-text {
      width: 200px !important;
      top: 15px !important; left: 20px !important;
      transform: rotate(-4deg) !important;
    }
    .ww-hero .ww-art-note {
      width: 160px !important;
      top: 175px !important; left: 30px !important;
      transform: rotate(-5deg) !important;
    }
    .ww-hero .ww-art-cal {
      width: 175px !important;
      top: 310px !important; left: 15px !important;
      transform: rotate(-3deg) !important;
    }
    .ww-hero .ww-art-invoice {
      width: 230px !important;
      top: 555px !important; left: 25px !important;
      transform: rotate(-2deg) !important;
    }
    /* Right column: chem → parts → checklist → call */
    .ww-hero .ww-art-chem {
      width: 200px !important;
      top: 10px !important; left: 260px !important;
      transform: rotate(3deg) !important;
    }
    .ww-hero .ww-art-parts {
      width: 180px !important;
      top: 165px !important; left: 280px !important;
      transform: rotate(2deg) !important;
    }
    .ww-hero .ww-art-checklist {
      width: 220px !important;
      top: 310px !important; left: 250px !important;
      transform: rotate(2deg) !important;
    }
    .ww-hero .ww-art-call {
      width: 195px !important;
      top: 575px !important; left: 270px !important;
      transform: rotate(4deg) !important;
    }
    /* Center bridge: photo straddles the two columns. */
    .ww-hero .ww-art-photo {
      width: 230px !important;
      height: 135px !important;
      top: 445px !important; left: 125px !important;
      transform: rotate(2deg) !important;
    }
    .ww-hero .ww-tag { display: inline-flex; }

    /* === Act 2 — phone-screen redesign for mobile ============
       The desktop dashboard is a 1280×740 landscape window with three
       columns. That shape doesn't fit a 375-wide phone viewport — at
       best it scales to a thin horizontal banner. So on mobile we
       reshape the same dashboard HTML into a 360×680 portrait phone
       UI: chrome becomes a slim app bar, the 3-column grid becomes
       a vertical scroll-feed, and several secondary panels are hidden
       so the remaining elements (next visit, chemistry, work order,
       activity feed) get readable space.
       The fit() script reads offsetWidth/offsetHeight, so changing
       these dimensions automatically reflows --ww-s.
       =============================================================== */
    .ww-hero .ww-shell .ww-frame {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 360px;
      height: 820px;
      margin: 0;
      transform-origin: center;
      transform: translate(-50%, -50%) scale(var(--ww-s, 1));
    }
    /* Phone bezel — heavy rounded corners + dark ring */
    .ww-hero .ww-shell .ww-window {
      height: 100%;
      border-radius: 36px;
      border: 6px solid #0a1929;
      box-shadow:
        0 0 0 2px rgba(125,211,252,.15) inset,
        0 60px 120px rgba(2,8,20,.6),
        0 0 80px rgba(125,211,252,.08);
    }

    /* Slim app bar — keep logo + customer chip, drop nav and divider */
    .ww-hero .ww-shell .ww-chrome {
      height: 48px;
      padding: 0 12px;
      gap: 10px;
    }
    .ww-hero .ww-shell .ww-chrome__logo { height: 22px; }
    .ww-hero .ww-shell .ww-chrome__divider { display: none; }
    .ww-hero .ww-shell .ww-chrome__nav { display: none; }
    .ww-hero .ww-shell .ww-chrome__customer {
      padding: 4px 10px 4px 4px;
      gap: 6px;
      margin-left: auto;
    }
    .ww-hero .ww-shell .ww-chrome__avatar {
      width: 24px; height: 24px; font-size: .65rem;
    }
    .ww-hero .ww-shell .ww-chrome__customer-name { font-size: .72rem; }
    .ww-hero .ww-shell .ww-chrome__customer-addr { font-size: .6rem; }

    /* Subbar — just title + active pill, drop the right-side meta */
    .ww-hero .ww-shell .ww-subbar { padding: 8px 14px; }
    .ww-hero .ww-shell .ww-subbar__title { font-size: .85rem; }
    .ww-hero .ww-shell .ww-subbar__right { display: none; }

    /* Grid → vertical scroll-feed */
    .ww-hero .ww-shell .ww-grid {
      display: flex;
      flex-direction: column;
      grid-template-columns: none;
      height: calc(100% - 48px - 36px);
      background: transparent;
      gap: 0;
      overflow: hidden;
    }
    .ww-hero .ww-shell .ww-col {
      padding: 10px 14px;
      gap: 10px;
      background: transparent;
    }

    /* Schedule column (first .ww-col in the grid — the original
       component doesn't put .ww-col--left on it, so target by
       position). Keep only the next-visit hero card. */
    .ww-hero .ww-shell .ww-grid > .ww-col:nth-child(1) { padding-top: 12px; }
    .ww-hero .ww-shell .ww-grid > .ww-col:nth-child(1) .ww-col__head { display: none; }
    .ww-hero .ww-shell .ww-grid > .ww-col:nth-child(1) > div:last-child { display: none; }
    .ww-hero .ww-shell .ww-next-visit__day { font-size: 1.1rem; }
    .ww-hero .ww-shell .ww-next-visit__day span { font-size: .6rem; }
    .ww-hero .ww-shell .ww-next-visit__when { font-size: .68rem; }
    .ww-hero .ww-shell .ww-next-visit__when strong { font-size: .82rem; }

    /* Service log column — drop the log-head, show chem strip and
       work order panel, hide the second "Repair pending" panel. */
    .ww-hero .ww-shell .ww-col--mid { padding: 4px 14px 10px; gap: 8px; }
    .ww-hero .ww-shell .ww-log-head { display: none; }
    .ww-hero .ww-shell .ww-col--mid > div:nth-of-type(1) .ww-col__title {
      font-size: .58rem;
      margin-bottom: 6px !important;
    }
    /* Chemistry strip — keep 5 tiles in a row at compressed size. */
    .ww-hero .ww-shell .ww-chem-row {
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
    }
    .ww-hero .ww-shell .ww-stat { padding: 6px 4px 8px; border-radius: 6px; }
    .ww-hero .ww-shell .ww-stat__label { font-size: .52rem; }
    .ww-hero .ww-shell .ww-stat__value { font-size: .8rem; }
    /* Twocol → single column, hide repair-pending panel. */
    .ww-hero .ww-shell .ww-twocol {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .ww-hero .ww-shell .ww-twocol > .ww-panel:last-child { display: none; }
    .ww-hero .ww-shell .ww-panel { padding: 10px 12px; border-radius: 10px; }
    .ww-hero .ww-shell .ww-panel__head strong { font-size: .8rem; }
    .ww-hero .ww-shell .ww-panel__head span { font-size: .7rem; }
    .ww-hero .ww-shell .ww-checklist__item { font-size: .72rem; }
    /* Trim work-order checklist to 3 items so the activity feed has
       room for the full invoice breakdown below it. */
    .ww-hero .ww-shell .ww-checklist__item:nth-child(n+4) { display: none; }

    /* Activity column (third .ww-col in the grid). Drop the col head
       entirely on mobile (saves ~30px) — Sarah's message + the invoice
       card are self-explanatory in context. Hide the two middle feed
       items (Marcus reply + Repair scheduled) so the screen has room
       for the full invoice breakdown including the total row.
       Extra bottom padding so the $392.00 total clears the rounded
       phone bezel rather than kissing it. */
    .ww-hero .ww-shell .ww-grid > .ww-col:nth-child(3) {
      padding-top: 4px;
      padding-bottom: 16px;
      gap: 8px;
    }
    .ww-hero .ww-shell .ww-grid > .ww-col:nth-child(3) .ww-col__head { display: none; }
    .ww-hero .ww-shell .ww-grid > .ww-col:nth-child(3) .ww-feed__item:nth-child(2),
    .ww-hero .ww-shell .ww-grid > .ww-col:nth-child(3) .ww-feed__item:nth-child(3) {
      display: none;
    }
    .ww-hero .ww-shell .ww-feed { gap: 8px; }
    .ww-hero .ww-shell .ww-feed__item { padding: 0; }
    .ww-hero .ww-shell .ww-feed__head { gap: 6px; margin-bottom: 4px; }
    .ww-hero .ww-shell .ww-feed__avatar { width: 20px; height: 20px; font-size: .6rem; }
    .ww-hero .ww-shell .ww-feed__who { font-size: .7rem; }
    .ww-hero .ww-shell .ww-feed__when { font-size: .6rem; }
    .ww-hero .ww-shell .ww-feed__bubble,
    .ww-hero .ww-shell .ww-feed__body { font-size: .72rem; line-height: 1.3; padding: 8px 10px; }
    .ww-hero .ww-shell .ww-feed__invoice { padding: 8px 10px; gap: 4px; }
    .ww-hero .ww-shell .ww-feed__invoice-row { font-size: .68rem; }
    .ww-hero .ww-shell .ww-feed__invoice-total { font-size: .8rem; padding-top: 4px; }
  }
</style>
