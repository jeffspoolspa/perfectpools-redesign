<script>
  // Lock both stages to their fixed pixel canvas sizes and scale to fit
  // their shell. Each stage has its own canvas:
  //   Act 1: 1280 × 680
  //   Act 2: 1280 × 740
  // Scale considers BOTH shell width and shell height so the artifacts
  // never get cut off vertically on short / narrow viewports. The
  // smaller of (width-fit, height-fit) wins; capped at 1 so we never
  // upscale past the source design size.
  (function(){
    function fit(){
      const stages = document.querySelectorAll('[data-ww-stage]');
      const frames = document.querySelectorAll('[data-ww-frame]');
      [...stages, ...frames].forEach((el) => {
        const shell = el.parentElement;
        if (!shell) return;
        const w = shell.clientWidth;
        const h = shell.clientHeight;
        if (w === 0) return; // skip until shell has actual width
        const isAct1 = el.matches('[data-ww-stage]');
        const canvasW = 1280;
        const canvasH = isAct1 ? 680 : 740;
        const sw = w / canvasW;
        // If shell has no explicit height (sandbox stacked layout, where
        // height is driven by aspect-ratio), height-fit will equal sw —
        // safe to ignore. If shell has explicit height (hero mode), this
        // adds the height constraint.
        const sh = h > 0 ? h / canvasH : Infinity;
