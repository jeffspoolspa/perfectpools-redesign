    // initial render (often width=0), after layout, after fonts, on
    // window resize, and continuously via ResizeObserver on each shell.
    fit();
    requestAnimationFrame(fit);
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(fit);
      document.querySelectorAll('.ww-stage-shell, .ww-shell').forEach((el) => ro.observe(el));
    }
  })();
