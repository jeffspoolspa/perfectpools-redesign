---
/**
 * WhyWeExistTwoActs — sandbox experiment
 * =======================================
 *
 * Direct port of the design bundle:
 *   - references/why-we-exist-design/website/project/Why We Exist · Act 1 · Disconnected.html
 *   - references/why-we-exist-design/website/project/Why We Exist · Act 2 · Under One Roof.html
 *
 * Combined under a single shared header per the user's brief
 * ("keeping the same header content but taking the artifacts in act 1
 * that transitions into the clean dashboard for the organized state").
 *
 * Two stages stacked vertically inside a dark-gradient wrapper:
 *
 *   Stage 1 — Act 1 · Disconnected
 *     9 artifacts scattered across a 1280×780 canvas with dashed red
 *     connector lines between them. Each artifact tells a piece of the
 *     "things slipping through the cracks" story (4-day-unanswered text,
 *     23-day-old chemistry, missed visit, $544 of bills from 4 vendors,
 *     12-day-stalled repair, algae photo, "forgot to tell" sticky note,
 *     5-step work order with 4 deferred items, 3 missed calls).
 *
 *   Stage 2 — Act 2 · Under One Roof
 *     A "Customer 360" dashboard window with Perfect Pools chrome.
 *     Three columns: Schedule (next visit + this-week timeline) ·
 *     Service log (chemistry stat tiles + work order + parts) ·
 *     Activity (Sarah's text → Marcus's reply → repair scheduled →
 *     consolidated invoice).
 *
 * The CSS uses the `.ww-` prefix throughout so it can't collide with
 * anything else in the project. All styling is `is:global` because the
 * classnames have to match the design bundle's HTML structure.
 *
 * Logo asset: served from /images/perfect-pools-logo.png (already
 * present in public/ from the existing project).
 */

const base = import.meta.env.BASE_URL;
const logoSrc = `${base}images/perfect-pools-logo.png`;
---

<div class="ww-root">
  {/* ============================================================
       STAGE 1 — "Disconnected" header + scattered artifacts
       Header copy mirrors the v1 ProblemScroll bad-state copy
       (kicker / headline / subhead) so the page can later flip
       between this and the resolved Stage 2 header.
       ============================================================ */}
  <header class="ww-header" data-ww-header="bad">
    <div class="ww-kicker">Why we exist</div>
    <h2 class="ww-headline">
      The pool industry has <em class="ww-headline__bad">too many handoffs.</em>
    </h2>
    <p class="ww-subhead">
      Maintenance, repairs, communication, and billing usually live in different places —
      or fall through the cracks entirely.
    </p>
  </header>

  <div class="ww-stage-shell">
    <div class="ww-stage-wrap" data-ww-stage="act1">
      <svg class="ww-connectors" viewBox="0 0 1280 680" preserveAspectRatio="none">
        {/* Dashed-red connectors weaving between scattered artifacts —
            each suggests a fragile "ad-hoc handoff" line. Coords are
            approximate; the connectors should never pass through the
            interior of an artifact, only between/around them. */}
        {/* Top row weaves: text → chem → parts */}
        <path d="M 330 100 C 420 70, 510 60, 580 80" />
        <path d="M 840 130 C 900 135, 970 140, 1000 140" />
        {/* Top-right vertical: parts → checklist */}
        <path d="M 1100 230 C 1100 250, 1100 270, 1100 290" />
        {/* Diagonal: text → photo (customer text references the algae) */}
        <path d="M 330 200 C 400 250, 460 290, 500 310" />
        {/* Diagonal: note → photo (forgot-to-mention → the bloom) */}
        <path d="M 200 380 C 300 370, 400 360, 500 365" />
        {/* Diagonal: photo → checklist (photo of issue → work order) */}
        <path d="M 720 360 C 800 370, 880 380, 930 390" />
        {/* Bottom horizontals: cal → invoice → call */}
        <path d="M 300 560 C 320 560, 350 560, 370 560" />
        <path d="M 700 580 C 730 580, 760 580, 770 580" />
        {/* Mid-right vertical: checklist → call */}
        <path d="M 1000 510 C 1000 520, 1000 530, 970 540" />
      </svg>

      <div class="ww-stage">
        {/* 1. Customer text — 4-day-unread thread */}
        <div class="ww-art ww-art-text">
          <div class="ww-art-text__head">
            <span class="ww-art-text__avatar"></span>
            Sarah · Mon 8:42 AM
            <span style="margin-left:auto;color:#dc2626;font-weight:700;font-size:.62rem;letter-spacing:.1em">UNREAD · 4d</span>
          </div>
          <div class="ww-art-text__body" style="margin-bottom:8px">
            Hey — pump's making a weird grinding sound. Should we be worried before the pool party Saturday?
          </div>
          <div class="ww-art-text__body" style="font-size:.82rem;color:#5b6b80;margin-bottom:6px">↑ Tue 11:14 AM   "Hello? Anyone there?"</div>
          <div class="ww-art-text__body" style="font-size:.82rem;color:#5b6b80">↑ Thu 6:02 PM   "Guess we'll find someone else."</div>
        </div>

        {/* 2. Chemistry reading — 23 days old */}
        <div class="ww-art ww-art-chem">
          <div class="ww-art-chem__head">
            <strong>Water chemistry</strong>
            <span style="color:#dc2626;font-weight:700">23 DAYS OLD</span>
          </div>
          <div class="ww-art-chem__rows">
            <div class="ww-art-chem__row ww-bad"><span>Free chlorine</span><span>0.2</span></div>
            <div class="ww-art-chem__row ww-bad"><span>pH</span><span>8.4</span></div>
            <div class="ww-art-chem__row ww-warn"><span>Alkalinity</span><span>180</span></div>
            <div class="ww-art-chem__row ww-bad"><span>Cyanuric acid</span><span>112</span></div>
            <div class="ww-art-chem__row"><span>Calcium</span><span>—</span></div>
          </div>
        </div>

        {/* 3. Calendar — missed visit */}
        <div class="ww-art ww-art-cal">
          <div class="ww-art-cal__head" style="background:#dc2626">Missed</div>
          <div class="ww-art-cal__date">
            <strong style="color:#dc2626">Tue</strong>
            <span>Aug 6 · No-show</span>
          </div>
          <div class="ww-art-cal__slot">
            <span style="text-decoration:line-through;color:var(--ww-text-light)">Visit</span>
            <span style="color:#dc2626">Skipped</span>
          </div>
          <div class="ww-art-cal__slot ww-art-cal__slot--booked">
            <span>Last visit</span>
            <span>26d ago</span>
