---
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomerIntakeForm from '../components/CustomerIntakeForm.tsx';
import GetStartedQuote from '../components/GetStartedQuote.tsx';
import '../styles/global.css';
import '../styles/fluid.css';
// Component-tool styles for the LSI calculator, sanitation tabs,
// filtration diagram, and HOCl time-series. These used to live in
// /our-approach.astro's scoped style block but the tool components
// are reusable across pages, so the styles ship globally now.
import '../styles/pool-tools.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalPath = '',
  ogImage = `${import.meta.env.BASE_URL}images/pool-cleaning.jpg`,
  schema,
} = Astro.props;

const siteUrl = 'https://perfectpoolscleaning.com';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="base-url" content={import.meta.env.BASE_URL} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Google Fonts: Plus Jakarta Sans (Azure Equilibrium) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content="Perfect Pools" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />

  <!-- Schema / JSON-LD -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? schema : schema)} />
  )}
</head>
<body>
  <!--
    C1: Top scroll progress bar.
    1px hairline that fills left→right based on document scroll. Lives at
    the top of the viewport on every page. Driven by the Lenis 'scroll'
    event so it stays in sync with the smoothed scroll position.
  -->
  <div id="pp-scroll-progress" aria-hidden="true"></div>

  <TopBar />
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <!-- Customer Intake Form (Preact island) -->
  <CustomerIntakeForm client:load />

  <!-- Get Started Quote Modal (Preact island) -->
  <GetStartedQuote client:load basePath={import.meta.env.BASE_URL} />

  {import.meta.env.DEV && (
    <div id="pp-viewport-indicator" aria-hidden="true">—</div>
    <script>
      const el = document.getElementById('pp-viewport-indicator');
      if (el) {
        const update = () => {
          el.textContent = `${window.innerWidth} × ${window.innerHeight}`;
        };
        update();
        window.addEventListener('resize', update);
      }
    </script>
  )}

  <!-- Lenis smooth scroll + GSAP sync -->
  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { initScrollReveals } from '../utils/scroll-reveals';

    gsap.registerPlugin(ScrollTrigger);

    const lenis = new Lenis({
      // A2: lerp instead of duration. Lerp = each frame moves N% toward
      // target. Gives the "weighted, viscous" feel Studio Freight uses by
      // default. duration mode is more snappy/predictable; lerp is more
      // premium-feeling.
      lerp: 0.1,
      // A3: wheelMultiplier 1.2 — Mac trackpads under-deliver wheel
      // velocity. Small bump makes scroll respond more eagerly without
      // feeling skittish.
      wheelMultiplier: 1.2,
      touchMultiplier: 2,
      // A1: Lenis intercepts every <a href="#section-id"> click and
      // smooth-scrolls to the anchor. Replaces native instant jumps.
      // Affects every nav link site-wide.
      anchors: true,
    });

    // Sync Lenis scroll position → ScrollTrigger
    lenis.on('scroll', ScrollTrigger.update);

    // Sync ScrollTrigger refreshes → Lenis. When GSAP adds or removes a
    // pin-spacer (e.g., a pinned section mounts), the document scroll
    // height changes. Lenis caches `dimensions` and won't notice unless
    // we tell it.
    ScrollTrigger.addEventListener('refresh', () => lenis.resize());

    // Belt-and-suspenders: a ResizeObserver on the documentElement
    // catches ANY body-height change — including async pin-spacer
    // insertion that doesn't fire the ScrollTrigger refresh event in
    // the order we expect. Without this, mounting multiple pinned
    // Preact islands can leave Lenis with a stale scroll limit.
    if ('ResizeObserver' in window) {
      let lastHeight = document.documentElement.scrollHeight;
      const ro = new ResizeObserver(() => {
        const h = document.documentElement.scrollHeight;
        if (Math.abs(h - lastHeight) > 1) {
          lastHeight = h;
          lenis.resize();
        }
      });
      ro.observe(document.documentElement);
    }

    // Drive Lenis from GSAP's ticker (one unified RAF loop)
    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    // Expose for modal stop/start
    (window as any).__lenis = lenis;

    // C1: Wire the top scroll progress bar to Lenis's smoothed scroll
    // position. Read .progress directly (0→1) so the bar stays in sync
    // with the visual scroll, not the native scroll position.
    const progressEl = document.getElementById('pp-scroll-progress');
    if (progressEl) {
      lenis.on('scroll', (e: any) => {
        progressEl.style.transform = `scaleX(${e.progress})`;
      });
    }

    // Initialize [data-reveal] scroll animations after all resources have
    // loaded so layout is settled and trigger positions are correct.
    function runReveals() {
      initScrollReveals();
    }
    // setTimeout(0) — fires after current microtask queue drains, more
    // reliable than rAF when the Lenis ticker is already hooked up.
    if (document.readyState === 'complete') {
      setTimeout(runReveals, 0);
    } else {
      window.addEventListener('load', () => setTimeout(runReveals, 0), { once: true });
    }
  </script>

  <!-- Intake form trigger + Get Started trigger + Mobile menu script -->
  <script>
    // Quote form trigger delegation — all quote/get-started buttons open the new GetStartedQuote modal
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('[data-open-intake], [data-open-get-started]');
      if (trigger) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('openGetStarted'));
      }
    });

    const toggle = document.getElementById('mobile-menu-toggle');
    const nav = document.getElementById('main-nav');

    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        nav.classList.toggle('is-open');
        document.body.style.overflow = isOpen ? '' : 'hidden';
      });

      // Handle dropdown toggles on mobile
      const dropdownItems = nav.querySelectorAll('.has-dropdown');
      dropdownItems.forEach((item) => {
        const link = item.querySelector('.nav-link');
        if (link && window.innerWidth < 1024) {
          link.addEventListener('click', (e) => {
            if (window.innerWidth < 1024) {
              e.preventDefault();
              item.classList.toggle('is-open');
            }
          });
        }
      });
    }

    // FAQ accordion
    document.querySelectorAll('.faq-question').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        if (item) {
          const wasActive = item.classList.contains('active');
          // Close all in same section
          item.parentElement?.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('active'));
          if (!wasActive) item.classList.add('active');
        }
      });
    });

    // Lawn-analogy tabs. Card stays in place; only the bubble icon and
    // copy cross-fade between states. Pill switcher at the bottom drives
    // the active state.
    document.querySelectorAll<HTMLElement>('[data-lawn-tabs]').forEach((tabs) => {
      const buttons = tabs.querySelectorAll<HTMLButtonElement>('.lawn-tabs__btn');
      const bubbles = tabs.querySelectorAll<HTMLElement>('.lawn-tabs__bubble');
      const copies = tabs.querySelectorAll<HTMLElement>('.lawn-tabs__copy');
      const nodes = tabs.querySelectorAll<HTMLElement>('.lawn-tabs__node');
      const fill = tabs.querySelector<HTMLElement>('.lawn-tabs__rail-fill');
      const order = Array.from(buttons).map((b) => b.dataset.lawn || '');
      const total = order.length;
      const indexOfKey = (key: string) => {
        const i = order.indexOf(key);
        return i < 0 ? 0 : i;
      };

      function setActive(target: string) {
        const idx = indexOfKey(target);
        tabs.dataset.active = order[idx];
        buttons.forEach((b) => {
          const active = b.dataset.lawn === order[idx];
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', String(active));
        });
        bubbles.forEach((bb) => {
          bb.classList.toggle('is-active', bb.dataset.lawnBubble === order[idx]);
        });
        copies.forEach((c) => {
          const i = indexOfKey(c.dataset.lawnCopy || '');
          c.classList.remove('is-active', 'is-off-left');
          if (i === idx) c.classList.add('is-active');
          else if (i < idx) c.classList.add('is-off-left');
        });
        nodes.forEach((n, i) => {
          n.classList.toggle('is-active', i === idx);
          n.classList.toggle('is-passed', i < idx);
        });
        if (fill) fill.style.width = total > 1 ? `${(idx / (total - 1)) * 100}%` : '0%';
      }

      setActive(tabs.dataset.active || order[0] || '');
      buttons.forEach((b) => {
        b.addEventListener('click', () => {
          if (b.dataset.lawn) setActive(b.dataset.lawn);
        });
      });
    });
  </script>

  <style is:global>
    /* C1 — Top scroll progress bar.
       Fixed at the very top of the viewport (above the topbar). 1.5px hairline,
       deep-blue accent. Uses `transform: scaleX(progress)` so the animation
       is GPU-composited and never reflows. transform-origin: left so it
       grows from the left edge as the user scrolls down. */
    #pp-scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--color-deep-blue, #145BB8);
      transform: scaleX(0);
      transform-origin: 0 0;
      z-index: 9999;
      pointer-events: none;
      will-change: transform;
    }

    #pp-viewport-indicator {
      position: fixed;
      bottom: 8px;
      right: 8px;
      z-index: 99999;
      padding: 4px 8px;
      font: 500 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #fff;
      background: rgba(0, 0, 0, 0.7);
      border-radius: 4px;
      pointer-events: none;
      user-select: none;
      letter-spacing: 0.02em;
    }
  </style>
</body>
</html>
