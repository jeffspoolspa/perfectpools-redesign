---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicePageFinale from '../components/ServicePageFinale.astro';

const faqs = [
  { question: 'How much does a site visit cost?', answer: 'Residential site visits are $150 and commercial site visits are $185. This covers travel, on-site inspection, equipment documentation, and the office time our team spends researching your specific equipment configuration to build an accurate estimate.' },
  { question: 'Do you charge for estimates?', answer: 'The site visit fee covers the full diagnostic and estimate process. You\'ll receive a detailed written estimate with every cost itemized — equipment, parts, PVC, electrical, and labor. There are no additional fees for the estimate itself.' },
  { question: 'Do you service all pool equipment brands?', answer: 'We are certified installers for Hayward, Pentair, Jandy, Fluidra, and AquaCal. We can service and repair most major brands, and our certified installer status means equipment we install comes with full manufacturer warranty coverage.' },
  { question: 'How do I know if my equipment should be repaired or replaced?', answer: 'That\'s exactly what our diagnostic process is designed to determine. We evaluate the age of the equipment, cost of repair vs. replacement, warranty implications, and whether the failure is isolated or systemic. Then we lay out your options clearly with costs and our honest recommendation.' },
  { question: 'Do your installations come with a warranty?', answer: 'Yes. As a certified installer for all major brands, equipment we install comes with full manufacturer warranty — typically two to three years depending on the product. We also handle the warranty claim process if anything goes wrong.' },
  { question: 'Can you work on my pool if another company installed the equipment?', answer: 'Absolutely. We service all major brands regardless of who installed them. If the equipment is still under manufacturer warranty, we\'ll work with the manufacturer on your behalf.' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Pool Equipment Service & Repair",
    "provider": { "@type": "LocalBusiness", "name": "Perfect Pools" },
    "areaServed": "Savannah, Richmond Hill, Brunswick, Coastal Georgia",
    "description": "Certified pool equipment diagnosis, repair, and installation. Pumps, filters, heaters, salt systems, automation, and more.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
  }
];

/* Equipment categories for the interactive grid.
   `description` — one-line summary used by the mobile diagram-tap card.
   `summary`     — ~2 sentence card text used by the click-to-expand grid.
   `detail`      — full long-form copy, currently unused on this page
                   but kept for reference / future deep pages. */
const equipment = [
  {
    id: 'pumps',
    name: 'Pumps & Motors',
    icon: 'pump',
    image: 'pump.png',
    description: 'Single-speed, dual-speed, and variable-speed pump service, repair, and installation.',
    summary: 'The heart of your circulation system. Variable-speed pumps cut energy costs and now meet federal efficiency standards — we\'ll help you choose between a rebuild, a seal swap, or a full upgrade.',
    detail: 'The heart of your pool\'s circulation system. We service and install single-speed, dual-speed, and variable-speed pumps across all major brands. Variable-speed pumps can cut your energy costs dramatically and are now required by federal efficiency standards on most replacements. We\'ll help you understand whether a motor rebuild, a seal replacement, or a full pump upgrade is the right move — and size it correctly for your plumbing and filter system.',
    brands: 'Hayward · Pentair · Jandy',
  },
  {
    id: 'filtration',
    name: 'Filtration Systems',
    icon: 'filter',
    description: 'Sand, glass media, cartridge, and DE filter maintenance and replacement.',
    summary: 'Sand, glass media, cartridge, and DE — each has different maintenance and replacement cycles. We help you pick the right media and keep flow rate and pressure where they should be.',
    detail: 'Your filter is what actually removes debris and particulates from the water. We work with all major filter types — sand, glass media, cartridge, and DE (diatomaceous earth). Each has different maintenance needs, replacement cycles, and performance characteristics depending on your pool size, usage, and plumbing. We\'ll help you choose the right media and keep your filter operating at the pressure and flow rate it was designed for.',
    brands: 'Sand & Glass Media · Cartridge · DE',
  },
  {
    id: 'chlorination',
    name: 'Chlorination Systems',
    icon: 'chlorination',
    description: 'Salt chlorine generators and tablet feeder installation and service.',
    summary: 'Salt cells or tablet feeders, sized to your pool and integrated with your circulation. Salt systems lower chemical costs but need proper sizing and routine cell maintenance.',
    detail: 'Proper sanitization is one of the three foundations of a clean pool. We install and service both salt chlorine generators and traditional tablet feeder systems. Salt systems generate chlorine continuously and can reduce your ongoing chemical costs, but they require proper sizing, compatible equipment, and regular cell maintenance. We\'ll recommend the right system for your pool and make sure it\'s integrated correctly with your circulation and automation.',
    brands: 'Salt Chlorine Generators · Tablet Feeders',
  },
  {
    id: 'heaters',
    name: 'Heaters & Heat Pumps',
    icon: 'heater',
    description: 'Gas heaters, electric heat pumps, and pool chillers for year-round comfort.',
    summary: 'Gas heaters, electric heat pumps, and chillers sized to your pool. Heat pumps are our most-recommended option in coastal Georgia.',
    detail: 'Extending your pool season — or making it comfortable year-round — starts with the right heating or cooling equipment matched to your pool volume, climate, and usage. We install and service gas heaters, electric heat pumps, and pool chillers. Heat pumps are the most energy-efficient option for our climate and are what we recommend most often, but the right choice depends on your pool size, how quickly you need to heat, and your utility costs.',
    brands: 'Gas · Heat Pumps · Chillers',
  },
  {
    id: 'automation',
    name: 'Automation & Controls',
    icon: 'automation',
    description: 'From basic timers to full smart-home-integrated control panels.',
    summary: 'From simple time clocks to smart-home platforms. Optimized run times protect equipment and let you control the pad from your phone.',
    detail: 'From basic analog timers to full smart-home-integrated control panels, automation determines how and when your equipment runs. We service and install systems ranging from simple time clocks and relay panels to advanced platforms like Hayward OmniLogic, Pentair IntelliCenter, and Jandy iAqualink. If you\'re upgrading equipment, automation is often the smartest investment — it optimizes run times, protects equipment, and gives you control from your phone.',
    brands: 'OmniLogic · IntelliCenter · iAqualink',
  },
  {
    id: 'cleaners',
    name: 'Automatic Pool Cleaners',
    icon: 'cleaner',
    description: 'Robotic cleaners and pressure-side cleaners for automated pool cleaning.',
    summary: 'Robotic units that run independently, or pressure-side cleaners like the Polaris line that use a booster pump. We\'ll help you pick what fits your pool and your existing plumbing.',
    detail: 'We service and install both robotic cleaners and water-powered pressure-side cleaners. Robotic cleaners operate independently from your pool\'s circulation system and are the most efficient option for most residential pools. Pressure-side cleaners like the Polaris line use a dedicated booster pump and are common in older installations. We\'ll help you understand which type fits your pool and whether your existing plumbing supports it.',
    brands: 'Robotic Cleaners · Pressure-Side (Polaris)',
  },
];
---

<BaseLayout
  title="Pool Equipment Service & Repair | Certified Diagnosis & Installation | Perfect Pools"
  description="Certified pool equipment repair and installation in Savannah, Brunswick & Coastal Georgia. Pumps, heaters, filters, salt systems, automation. Manufacturer-backed warranties. Call (912) 459-0160."
  canonicalPath="/service-repair/"
  schema={schema}
>
  <!-- ============ HERO ============ -->
  <section class="sr-hero">
    <img
      src={`${import.meta.env.BASE_URL}images/hero-service-repair.jpg`}
      alt="Perfect Pools technician working on pool equipment"
      class="sr-hero__photo"
      loading="eager"
    />
    <div class="sr-hero__overlay"></div>
    <div class="container sr-hero__content">
      <h1 class="sr-hero__title">We Don't Guess.<br/>We Diagnose.</h1>
      <div class="sr-hero__actions">
        <button type="button" class="btn btn--cta btn--lg" data-open-intake>Schedule a Site Visit</button>
        <a href="tel:9124590160" class="btn btn--outline-white btn--lg">Call (912) 459-0160</a>
      </div>
    </div>
  </section>

  <!-- ============ TECHNICAL PHILOSOPHY ============ -->
  <section class="section section--dark-diagram">
    <div class="container">
      <div class="philosophy-header">
        <span class="section-label section-label--light">Our approach</span>
        <h2>Your Pool Is a System, Not a Collection of Parts</h2>
      </div>
      <div class="philosophy-layout">
        <div class="philosophy-layout__content">
          <div class="philosophy-text">
            <p>Most pool problems trace back upstream of the symptom. We treat every pool as a system — water movement, filtration, and chlorination dialed in together — so you stop chasing band-aid repairs.</p>
          </div>
          {equipment.map((item) => (
            <article class="eq-info" data-eq-info={item.id}>
              <h3 class="eq-info__title">{item.name}</h3>
              <p class="eq-info__detail">{item.detail}</p>
              <span class="eq-info__brands">{item.brands}</span>
            </article>
          ))}
        </div>
        <div class="philosophy-layout__diagram">
          <p class="diagram-hint">Tap a piece of equipment to learn more</p>
          <div class="diagram-wrapper">
            <img
              src={`${import.meta.env.BASE_URL}images/pool-equipment-diagram.png`}
              alt="Pool equipment system diagram showing how water flows through the pump, filter, heater, chlorinator, and back to the pool"
              class="diagram-img"
              loading="lazy"
              width="2816"
              height="1536"
            />
            <!-- Tap hotspot regions over equipment on the pad -->
            <button type="button" data-eq="pumps" class="diagram-hotspot" style="top: 54.4%; left: 57.5%; width: 9.6%; height: 9.5%;" aria-label="Pump"></button>
            <button type="button" data-eq="filtration" class="diagram-hotspot" style="top: 44.7%; left: 69.0%; width: 6.3%; height: 18.8%;" aria-label="Filter"></button>
            <button type="button" data-eq="heaters" class="diagram-hotspot" style="top: 48.3%; left: 77.4%; width: 6.4%; height: 15.6%;" aria-label="Heater"></button>
            <button type="button" data-eq="chlorination" class="diagram-hotspot" style="top: 56.4%; left: 85.9%; width: 6.9%; height: 5.0%;" aria-label="Salt Cell"></button>
            <button type="button" data-eq="automation" class="diagram-hotspot" style="top: 29.5%; left: 61.2%; width: 6.7%; height: 14.2%;" aria-label="Automation Controller"></button>
          </div>

          {/* Mobile-only description card. Sits below the diagram and
              is populated/revealed when a hotspot is tapped. The
              shortened description (item.description) reads quickly
              without re-iterating the long-form copy that's also in
              the equipment grid further down the page. */}
          <div class="eq-mobile-stack" data-eq-mobile-stack>
            {equipment.filter((item) => ['pumps', 'filtration', 'heaters', 'chlorination', 'automation'].includes(item.id)).map((item) => (
              <article class="eq-mobile-info" data-eq-mobile-info={item.id}>
                <h3 class="eq-mobile-info__title">{item.name}</h3>
                <p class="eq-mobile-info__desc">{item.description}</p>
                <span class="eq-mobile-info__brands">{item.brands}</span>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CERTIFIED INSTALLATION ============ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" style="max-width: 800px; margin-bottom: var(--space-12);">
        <span class="section-label">Certifications</span>
        <h2>Certified Installer. Manufacturer-Backed Warranty.</h2>
        <p class="section-header__subtitle">When we install equipment, it comes with a full manufacturer's warranty — typically two to three years. In coastal Georgia where salt air accelerates wear on everything, that coverage matters.</p>
      </div>

      <!-- Brand logos — infinite marquee -->
      <div class="brand-marquee" aria-label="Certified installer brands">
        <div class="brand-marquee__track">
          {[0, 1].map(() => (
            <div class="brand-marquee__group" aria-hidden={false}>
              <img src={`${import.meta.env.BASE_URL}images/brands/hayward-logo.png`} alt="Hayward" class="brand-logo" />
              <img src={`${import.meta.env.BASE_URL}images/brands/aquacal-logo.png`} alt="AquaCal" class="brand-logo" />
              <img src={`${import.meta.env.BASE_URL}images/brands/jandy-logo.png`} alt="Jandy" class="brand-logo" />
              <img src={`${import.meta.env.BASE_URL}images/brands/pentair-logo.png`} alt="Pentair" class="brand-logo" />
              <img src={`${import.meta.env.BASE_URL}images/brands/polaris-logo.png`} alt="Polaris" class="brand-logo" />
              <img src={`${import.meta.env.BASE_URL}images/brands/intermatic.png`} alt="Intermatic" class="brand-logo" />
            </div>
          ))}
        </div>
      </div>

      <div class="warranty-grid">
        <div class="warranty-card">
          <div class="warranty-card__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
          </div>
          <h3>Full warranty coverage</h3>
          <p>Equipment we install comes with manufacturer-backed warranty. Non-certified installers or self-installs often don't qualify — and when something fails 18 months in, you pay full price again.</p>
        </div>

        <div class="warranty-card">
          <div class="warranty-card__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>We handle warranty claims</h3>
          <p>If something fails under warranty, we manage the entire claim process. We know the manufacturers, the documentation they need, and we advocate on your behalf to make sure it's honored.</p>
        </div>

        <div class="warranty-card">
          <div class="warranty-card__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3>Vetted products only</h3>
          <p>We're selective about what we sell. If we don't trust the product to last or the company to honor their warranty, we won't put it on your pool. Hundreds of installs behind every brand we recommend.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICE PROCESS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-header" style="max-width: 800px; margin-bottom: var(--space-12);">
        <span class="section-label">How it works</span>
        <h2>Every Job Starts with a Site Visit</h2>
        <p class="section-header__subtitle">Every repair, installation, and equipment upgrade begins the same way — with a technician on-site collecting the information our service team needs to do the job right.</p>
      </div>

      <div class="process-steps">
        <div class="process-step">
          <div class="process-step__number">1</div>
          <div class="process-step__content">
            <h3>On-site inspection</h3>
            <p>Your tech documents part numbers, model information, takes detailed photos of your equipment pad and plumbing layout, assesses the overall system condition, and notes anything that could affect scope.</p>
          </div>
        </div>

        <div class="process-step">
          <div class="process-step__number">2</div>
          <div class="process-step__content">
            <h3>Research & estimate</h3>
            <p>That information goes to our service team, who research your specific configuration and build a detailed estimate — equipment, parts, PVC, electrical, labor. No vague line items. No surprises on install day.</p>
          </div>
        </div>

        <div class="process-step">
          <div class="process-step__number">3</div>
          <div class="process-step__content">
            <h3>Scheduled installation</h3>
            <p>Once you approve the estimate, we schedule the work and show up prepared — right equipment, right parts, right plan. The job gets done correctly the first time.</p>
          </div>
        </div>
      </div>

      <!-- Site visit fee callout -->
      <div class="fee-callout">
        <div class="fee-callout__prices">
          <div class="fee-callout__price">
            <span class="fee-callout__label">Residential</span>
            <span class="fee-callout__amount">$150</span>
          </div>
          <div class="fee-callout__divider"></div>
          <div class="fee-callout__price">
            <span class="fee-callout__label">Commercial</span>
            <span class="fee-callout__amount">$185</span>
          </div>
        </div>
        <div class="fee-callout__text">
          <p><strong>Why we charge for site visits:</strong> This covers travel, time on-site gathering accurate information, and the office time our team spends researching your equipment to make sure what we recommend is right for your pool.</p>
          <p>The alternative is a company that shows up, glances at your equipment, and quotes from memory. That's how you end up with a pump that isn't graded for your filter, or a heater undersized for your pool volume. We'd rather get it right the first time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ REPAIR VS REPLACE ============ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header" style="max-width: 800px; margin-bottom: var(--space-12);">
        <span class="section-label">Honest diagnosis</span>
        <h2>Repair When It Makes Sense. Replace When It Doesn't.</h2>
        <p class="section-header__subtitle">One of the most valuable things a qualified technician can do is tell you honestly whether equipment should be repaired or replaced.</p>
      </div>

      <div class="compare-layout">
        <div class="compare-card compare-card--repair">
          <div class="compare-card__header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            <h3>The repair-only shop</h3>
          </div>
          <p>Saves you money short-term. But if they're replacing seals without recognizing the motor is overheating — which burned the seals in the first place — you're paying twice for a fix that won't last.</p>
        </div>

        <div class="compare-card compare-card--replace">
          <div class="compare-card__header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
            <h3>The replace-everything shop</h3>
          </div>
          <p>Puts in brand new equipment when a straightforward repair would have given you years more life out of what you already have. Costs more than necessary.</p>
        </div>
      </div>

      <div class="our-approach-card">
        <div class="our-approach-card__icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div>
          <h3>Our approach: the right call, not the easy one</h3>
          <p>We evaluate equipment age, repair vs. replacement cost, warranty coverage, and whether the failure is isolated or systemic. Then we lay out your options clearly — what each path costs, what it gets you, and what we'd recommend if it were our pool.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EQUIPMENT WE SERVICE ============ -->
  <section class="section">
    <div class="container">
      <div class="section-header" style="max-width: 800px; margin-bottom: var(--space-12);">
        <span class="section-label">Equipment</span>
        <h2>Equipment We Service, Repair & Install</h2>
      </div>

      <div class="equipment-grid" data-state="default">
        {equipment.map((item, i) => (
          <article class="eq-tile" id={`eq-${item.id}`} data-eq-id={item.id} data-l-pos={i + 1} role="button" tabindex="0">
            <div class="eq-tile__icon">
              {item.icon === 'pump' && <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>}
              {item.icon === 'filter' && <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>}
              {item.icon === 'chlorination' && <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2v17.5c0 1.4-1.1 2.5-2.5 2.5s-2.5-1.1-2.5-2.5V2"/><path d="M8.5 2h7"/><path d="M14.5 16h-5"/></svg>}
              {item.icon === 'heater' && <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/></svg>}
              {item.icon === 'automation' && <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>}
              {item.icon === 'cleaner' && <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/></svg>}
            </div>
            <div class="eq-tile__card">
              <h3 class="eq-tile__name">{item.name}</h3>
              <div class="eq-tile__expand">
                <p class="eq-tile__detail">{item.summary}</p>
                <span class="eq-tile__brands">{item.brands}</span>
              </div>
            </div>
            <button class="eq-tile__close" type="button" aria-label="Close details">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ServicePageFinale
    faqs={faqs}
    ctaHeading="Need a Diagnosis?"
    ctaText="Schedule a site visit and let our team assess your equipment. You'll get a detailed estimate with every cost laid out — no surprises, no pressure."
    ctaButtons={[
      { label: 'Schedule a Site Visit', openIntake: true, variant: 'cta' },
      { label: 'Call (912) 459-0160', href: 'tel:9124590160', variant: 'outline-white' },
    ]}
  />

  <!-- Diagram tap → reveal description card. On desktop the eq-info
       card slides in over the intro text on the left; on mobile the
       eq-mobile-info card appears below the diagram and the diagram
       gently scrolls toward viewport center so the active region
       stays visible without jumping. -->
  <script>
    const philosophyLayout = document.querySelector('.philosophy-layout');
    if (philosophyLayout) {
      const hotspots = philosophyLayout.querySelectorAll('.diagram-hotspot');
      const infoCards = philosophyLayout.querySelectorAll('.eq-info');
      const mobileInfoCards = philosophyLayout.querySelectorAll('.eq-mobile-info');
      const diagramWrapper = philosophyLayout.querySelector('.diagram-wrapper');
      let activeId: string | null = null;

      function setActiveId(id: string | null) {
        activeId = id;
        infoCards.forEach((card) => {
          const matches = id !== null && (card as HTMLElement).dataset.eqInfo === id;
          card.classList.toggle('is-active', matches);
        });
        mobileInfoCards.forEach((card) => {
          const matches = id !== null && (card as HTMLElement).dataset.eqMobileInfo === id;
          card.classList.toggle('is-active', matches);
        });
        philosophyLayout.classList.toggle('is-active', id !== null);
      }

      hotspots.forEach((hotspot) => {
        hotspot.addEventListener('click', (e) => {
          e.preventDefault();
          const id = (hotspot as HTMLElement).dataset.eq;
          if (!id) return;
          // Tap the already-active hotspot to close.
          if (id === activeId) {
            setActiveId(null);
            return;
          }
          setActiveId(id);
          // No auto-scroll on tap — the layout shift (intro collapses
          // out, diagram + description card animate in) happens in
          // the user's current viewport so the page stays put.
        });
      });

      // Tap outside the diagram or on any non-hotspot area inside it → close.
      document.addEventListener('click', (e) => {
        if (activeId === null) return;
        const target = e.target as HTMLElement;
        if (target.closest('.diagram-hotspot')) return;
        if (target.closest('.eq-mobile-info') || target.closest('.eq-info')) return;
        setActiveId(null);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && activeId !== null) setActiveId(null);
      });
    }
  </script>

  <!-- Equipment grid: CLICK to expand. Hand-rolled spring physics drives
       each tile's transform — springs keep their velocity across state
       changes, so clicking a new icon mid-flight smoothly redirects the
       animation instead of waiting for it to finish. -->
  <script>
    (() => {
      const grid = document.querySelector('.equipment-grid');
      if (!grid) return;
      const tiles = Array.from(grid.querySelectorAll('.eq-tile'));

      // Spring config — tuned for soft, snappy motion that still settles fast
      const STIFFNESS = 180;
      const DAMPING = 24;
      const REST_POS = 0.1;
      const REST_VEL = 0.5;

      // Per-tile spring state: position (offset from layout), velocity
      const springs = new Map();
      tiles.forEach((t) => springs.set(t, { x: 0, y: 0, vx: 0, vy: 0 }));

      let activeTile = null;
      let rafId = null;
      let lastFrame = 0;

      function setActive(target) {
        if (target === activeTile) return;

        // Capture current VISUAL rects (with any in-flight transforms applied)
        const before = new Map();
        tiles.forEach((t) => before.set(t, t.getBoundingClientRect()));

        // Snap inline transforms to none so the after-rect reflects PURE layout
        tiles.forEach((t) => { t.style.transform = ''; });
        void grid.offsetHeight; // force reflow

        // Apply state change
        grid.dataset.state = target !== null ? 'active' : 'default';
        tiles.forEach((t) => t.classList.toggle('is-active', t === target));
        activeTile = target;

        // For each tile: compute delta from current visual → new layout,
        // and set the spring position to that delta. Velocity is preserved
        // so mid-flight clicks redirect smoothly with momentum.
        tiles.forEach((t) => {
          const b = before.get(t);
          const a = t.getBoundingClientRect();
          const spring = springs.get(t);
          spring.x = b.left - a.left;
          spring.y = b.top - a.top;
          // Apply the initial transform so the tile visually stays put
          if (Math.abs(spring.x) > 0.1 || Math.abs(spring.y) > 0.1) {
            t.style.transform = 'translate(' + spring.x + 'px, ' + spring.y + 'px)';
          }
        });

        // After the icon springs into place, the card content emerges from
        // the icon's top-left corner — scaling up and out to its final
        // centered position. Origin = icon, destination = card's natural spot.
        if (target) {
          const icon = target.querySelector('.eq-tile__icon');
          const card = target.querySelector('.eq-tile__card');
          const close = target.querySelector('.eq-tile__close');

          if (card && icon) {
            // Measure final layout positions for icon + card
            const iconRect = icon.getBoundingClientRect();
            const cardRect = card.getBoundingClientRect();
            const dx = iconRect.left - cardRect.left;
            const dy = iconRect.top - cardRect.top;

            card.style.transformOrigin = '0 0';
            card.style.transition = 'none';
            card.style.transform = 'translate(' + dx + 'px, ' + dy + 'px) scale(0.05)';
            card.style.opacity = '0';
            void card.offsetHeight;

            window.setTimeout(() => {
              card.style.transition = 'transform 0.6s cubic-bezier(0.32, 1.2, 0.32, 1), opacity 0.45s ease';
              card.style.transform = 'translate(0, 0) scale(1)';
              card.style.opacity = '1';
              const cleanup = (e) => {
                if (e.propertyName !== 'transform') return;
                card.style.transition = '';
                card.style.transform = '';
                card.style.opacity = '';
                card.style.transformOrigin = '';
                card.removeEventListener('transitionend', cleanup);
              };
              card.addEventListener('transitionend', cleanup);
            }, 280);
          }

          if (close) {
            close.style.opacity = '0';
            close.style.transition = 'none';
            void close.offsetHeight;
            window.setTimeout(() => {
              close.style.transition = 'opacity 0.3s ease';
              close.style.opacity = '1';
              const cleanup = () => {
                close.style.transition = '';
                close.style.opacity = '';
                close.removeEventListener('transitionend', cleanup);
              };
              close.addEventListener('transitionend', cleanup);
            }, 450);
          }
        }

        startSpringLoop();
      }

      function startSpringLoop() {
        if (rafId !== null) return;
        lastFrame = performance.now();
        rafId = requestAnimationFrame(tick);
      }

      function tick(now) {
        const dt = Math.min(0.033, (now - lastFrame) / 1000);
        lastFrame = now;

        let stillMoving = false;
        springs.forEach((spring, tile) => {
          if (
            Math.abs(spring.x) < REST_POS && Math.abs(spring.y) < REST_POS &&
            Math.abs(spring.vx) < REST_VEL && Math.abs(spring.vy) < REST_VEL
          ) {
            // Settled — snap to zero and clear transform
            if (spring.x !== 0 || spring.y !== 0 || tile.style.transform) {
              spring.x = 0; spring.y = 0; spring.vx = 0; spring.vy = 0;
              tile.style.transform = '';
            }
            return;
          }

          // Spring physics: force = -k*x - c*v
          const ax = -STIFFNESS * spring.x - DAMPING * spring.vx;
          const ay = -STIFFNESS * spring.y - DAMPING * spring.vy;
          spring.vx += ax * dt;
          spring.vy += ay * dt;
          spring.x += spring.vx * dt;
          spring.y += spring.vy * dt;

          tile.style.transform = 'translate(' + spring.x.toFixed(2) + 'px, ' + spring.y.toFixed(2) + 'px)';
          stillMoving = true;
        });

        if (stillMoving) {
          rafId = requestAnimationFrame(tick);
        } else {
          rafId = null;
        }
      }

      // Click handlers — entire tile is the click target (except close btn)
      tiles.forEach((tile) => {
        const close = tile.querySelector('.eq-tile__close');
        tile.addEventListener('click', (e) => {
          if (tile === activeTile) return;
          if (close && close.contains(e.target)) return; // close handled separately
          setActive(tile);
        });
        tile.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if (tile === activeTile) return;
          e.preventDefault();
          setActive(tile);
        });
        if (close) close.addEventListener('click', (e) => {
          e.stopPropagation();
          setActive(null);
        });
      });

      // Click outside the grid → close
      document.addEventListener('click', (e) => {
        if (!activeTile) return;
        if (grid.contains(e.target)) return;
        setActive(null);
      });

      // Esc → close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && activeTile) setActive(null);
      });
    })();
  </script>

</BaseLayout>

<style>
  /* ============ HERO ============ */
  .sr-hero {
    position: sticky;
    top: 0;
    z-index: 0;
    padding: var(--space-8) 0;
    background: var(--color-dark-blue);
    color: white;
    overflow: hidden;
    min-height: 640px;
    display: flex;
    align-items: center;
  }

  /* All sections below hero must paint over it as the user scrolls.
     Transparent sections need an explicit bg so the sticky hero
     doesn't bleed through underneath. */
  .sr-hero ~ section {
    position: relative;
    z-index: 1;
    background-color: var(--color-bg);
  }

  /* Preserve sections that have their own background. */
  .sr-hero ~ section.section--alt { background-color: var(--color-bg-alt); }
  .sr-hero ~ section.section--dark-diagram { background-color: #1a1f2e; }
  .sr-hero ~ section.cta-section {
    background: linear-gradient(135deg, var(--color-dark-blue) 0%, var(--color-primary) 100%);
  }

  .sr-hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: 0;
  }

  .sr-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 22, 47, 0.85) 0%, rgba(10, 22, 47, 0.55) 55%, rgba(10, 22, 47, 0.35) 100%);
    z-index: 1;
  }

  .sr-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
  }

  .sr-hero__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 0;
    color: white;
  }

  .sr-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .sr-hero {
      padding: var(--space-10) 0;
    }

    .sr-hero__content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
    }

    .sr-hero__title {
      flex: 0 1 auto;
      margin: 0;
    }

    .sr-hero__actions {
      flex: 0 0 auto;
    }
  }

  /* ============ SECTION LABEL (shared) ============ */
  .section-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  /* ============ TECHNICAL PHILOSOPHY ============ */
  .philosophy-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .philosophy-header h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.15;
    color: white;
    margin-top: var(--space-3);
  }

  .philosophy-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 960px) {
    .philosophy-layout {
      grid-template-columns: 2fr 3fr;
    }
  }

  .diagram-hint {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
  }

  .philosophy-layout__content {
    position: relative;
    max-width: 800px;
    min-height: 240px;
  }

  .philosophy-text {
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .philosophy-text p {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .philosophy-text p:last-child {
    margin-bottom: 0;
  }

  .philosophy-layout.is-hovering .philosophy-text,
  .philosophy-layout.is-active .philosophy-text {
    opacity: 0;
    transform: translateX(-12px);
  }

  /* On mobile (single-column), collapse the intro text out of flow
     when a hotspot is active so the diagram visually slides up into
     its slot. Both the container height collapse and the text fade
     run at the same 500ms duration with matching easing, so the
     diagram + text move together as one motion instead of the text
     fading first and the diagram catching up. */
  @media (max-width: 959px) {
    .philosophy-layout__content {
      min-height: 0;
      max-height: 60vh;
      overflow: hidden;
      transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                  margin-bottom 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .philosophy-text {
      transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .philosophy-layout.is-active .philosophy-layout__content {
      max-height: 0;
      opacity: 0;
      margin-bottom: calc(var(--space-12) * -1);
    }
    /* Hide the desktop eq-info card — on mobile the equipment summary
       is rendered via .eq-mobile-info below the diagram, so the
       desktop card would otherwise briefly flash in over the
       collapsing intro text mid-transition. */
    .eq-info,
    .eq-info.is-active {
      display: none;
    }
  }

  /* Equipment info modal */
  .eq-info {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    opacity: 0;
    transform: translateX(-12px);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .eq-info.is-active {
    opacity: 1;
    transform: translateX(0);
  }

  .eq-info__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: white;
    margin-bottom: var(--space-4);
  }

  .eq-info__detail {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .eq-info__brands {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    background: rgba(255, 255, 255, 0.08);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  /* Diagram slide */
  .philosophy-layout__diagram {
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .philosophy-layout.is-hovering .philosophy-layout__diagram,
  .philosophy-layout.is-active .philosophy-layout__diagram {
    transform: translateX(32px);
  }

  /* On mobile keep the diagram un-shifted — the horizontal slide only
     makes sense in the desktop 2-column layout where the text vacates
     the left side. */
  @media (max-width: 959px) {
    .philosophy-layout.is-active .philosophy-layout__diagram {
      transform: none;
    }
  }

  /* === Mobile equipment-info card (below the diagram) ===========
     Sits in the diagram column on mobile and reveals a single
     equipment description when a hotspot is tapped. Hidden on
     desktop where the existing .eq-info card on the left handles
     the same job. */
  .eq-mobile-stack {
    display: none;
  }

  @media (max-width: 959px) {
    .eq-mobile-stack {
      display: block;
      position: relative;
      margin-top: var(--space-5);
