---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import WhyWeExistHero from '../components/WhyWeExistHero.astro';
const base = import.meta.env.BASE_URL;

/**
 * Our Approach — storytelling page.
 *
 * The 5 pinned card-stack sections (Problem / Our Story / Pillars /
 * Compare / Visit) handle their own internal GSAP animations. The page
 * itself is plain <section> flow with alternating backgrounds. The
 * Reviews and final CTA get simple data-reveal entrance animations
 * (see src/utils/scroll-reveals.ts).
 *
 * Section-to-section cohesion (pinned handoffs between sections) is
 * a larger refactor parked for later — it requires rewriting the 5
 * scroll components to expose a shared timeline API instead of
 * self-pinning independently. When that lands, come back here and
 * orchestrate the sequence from one place.
 */
---

<BaseLayout
  title="Our Approach to Pool Care | Perfect Pools"
  description="Pool care isn't guesswork — it's chemistry, consistency, and accountability. Learn how Perfect Pools keeps your water balanced year-round in coastal Georgia."
  canonicalPath="/our-approach"
>
  {/* Section 1 — Why We Exist hero (artifacts → dashboard scroll-swap) */}
  <WhyWeExistHero />

  {/* Section 2 — Our Story (company timeline) */}
  <section class="section oa-section" id="our-story" data-next-label="Three pillars">
    <div class="container">
      <div id="timeline-mount"></div>
    </div>
  </section>

  {/* Section 3 — Three Pillars */}
  <section class="section pillars-section oa-section" id="pillars" data-next-label="Industry vs us">
    <div class="container">
      <div id="pillars-mount"></div>
    </div>
  </section>

  {/* Section 4 — Industry vs Us Comparison */}
  <section class="section compare-scroll-section oa-section" id="compare" data-next-label="Anatomy of a visit">
    <div class="container">
      <div id="compare-mount"></div>
    </div>
  </section>

  {/* Section 5 — Anatomy of a Visit */}
  <section class="section visit-section oa-section" id="visit" data-next-label="What clients say">
    <div class="container">
      <div id="visit-mount"></div>
    </div>
  </section>

  {/* Section 6 — Reviews */}
  <section class="section oa-section" id="reviews">
    <div class="container">
      <div class="section-header" data-reveal="fade-up">
        <span class="section-kicker">WHAT OUR CLIENTS SAY</span>
        <h2>Real Reviews, Real Results.</h2>
      </div>
      <div data-reveal="fade-up" data-reveal-stagger="0.12">
        <ReviewCarousel />
        <div style="text-align: center; margin-top: var(--space-8);">
          <a href="https://g.page/r/CVrU0W_3-NRyEAE/review" target="_blank" rel="noopener" class="btn btn--outline">Read All Reviews on Google</a>
        </div>
      </div>
    </div>
  </section>

  {/* Section 7 — Final CTA */}
  <section class="partnership-cta oa-section">
    <div class="container">
      <div class="partnership-cta__card" data-reveal="scale-in" data-reveal-start="top 85%" data-reveal-end="top 55%">
        <h2>Start Your Aquatic Partnership</h2>
        <p>Experience the difference of architectural-grade maintenance. We are currently accepting new clients for our exclusive service routes.</p>
        <div class="partnership-cta__buttons">
          <a href={`${base}get-started/`} class="btn btn--cta btn--lg">Join Our Route</a>
          <a href={`${base}plans/`} class="btn btn--outline-white btn--lg">View Pricing</a>
        </div>
      </div>
    </div>
  </section>

  {/* Sticky chapter marker (top-left) + side rail (right) — Lenis nav UX */}
  <div id="oa-nav-mount"></div>

  {/* B2 — Next-section hint. Fades in when the user is near the bottom
      of a long pinned section, so they know the page continues. */}
  <div id="oa-end-hint" class="oa-section-end-hint" aria-hidden="true">
    <span class="oa-section-end-hint__arrow">↓</span>
    <span id="oa-end-hint-label">Next</span>
  </div>
</BaseLayout>

<script>
  import { render, h } from 'preact';
  import OurStorySplit from '../components/OurStorySplit.tsx';
  import PillarsScroll from '../components/PillarsScroll.tsx';
  import CompareScroll from '../components/CompareScroll.tsx';
  import VisitScroll from '../components/VisitScroll.tsx';
  import OurApproachNav from '../components/OurApproachNav.tsx';

  const timelineMount = document.getElementById('timeline-mount');
  if (timelineMount) {
    render(h(OurStorySplit, null), timelineMount);
  }

  const pillarsMount = document.getElementById('pillars-mount');
  if (pillarsMount) {
    render(h(PillarsScroll, null), pillarsMount);
  }

  const visitMount = document.getElementById('visit-mount');
  if (visitMount) {
    render(h(VisitScroll, null), visitMount);
  }

  // Mount the Lenis-aware sticky chapter marker + side-rail navigation.
  const navMount = document.getElementById('oa-nav-mount');
  if (navMount) {
    render(h(OurApproachNav, null), navMount);
  }

  // D1 — Velocity-driven parallax on the dome's pool image.
  // Reads lenis.velocity each frame and shifts the image Y by a small
  // fraction of it. Scroll fast → image lags slightly. Scroll slow / at
  // rest → image is in its natural position.
  // Listens to lenis.scroll (which fires every frame the user is scrolling)
  // so we don't need our own RAF.
  {
    const lenis = (window as any).__lenis;
    let parallaxEl: HTMLElement | null = null;
    const findEl = () => {
      parallaxEl = document.querySelector<HTMLElement>('.prb__hub-pool');
      return parallaxEl;
    };
    const applyParallax = () => {
      if (!parallaxEl && !findEl()) return;
      const v = lenis?.velocity ?? 0;
      // Clamp the offset so it never goes wild on very fast scrolls.
      const offset = Math.max(-12, Math.min(12, v * 0.6));
      parallaxEl!.style.transform = `translate3d(0, ${offset}px, 0)`;
    };
    if (lenis?.on) {
      lenis.on('scroll', applyParallax);
    } else {
      window.addEventListener('scroll', applyParallax, { passive: true });
    }
  }

  // B2 — Drive the "↓ Next: ..." hint. For each pinned section that has
  // a data-next-label, show the hint when the section's bottom is near
  // the viewport bottom (the section is "almost done"). Hide otherwise.
  const endHint = document.getElementById('oa-end-hint');
  const endHintLabel = document.getElementById('oa-end-hint-label');
  if (endHint && endHintLabel) {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-next-label]')
    );
    const updateHint = () => {
      const vh = window.innerHeight;
      // Find a section whose bottom is in the lower 25% of the viewport
      // (i.e. user is near the end of that section's pin spacer).
      let activeNext: string | null = null;
      for (const sec of sections) {
        const rect = sec.getBoundingClientRect();
        const bottomVisible = rect.bottom;
        // "Near the end" = section bottom is in the bottom 25% of viewport
        // and we're still inside the section.
        if (bottomVisible > vh * 0.55 && bottomVisible < vh * 1.05 && rect.top < 0) {
          activeNext = sec.getAttribute('data-next-label');
          break;
        }
      }
      if (activeNext) {
        endHintLabel.textContent = activeNext;
        endHint.classList.add('is-visible');
      } else {
        endHint.classList.remove('is-visible');
      }
    };
    // Update on scroll via Lenis if available, otherwise native.
    const lenis = (window as any).__lenis;
    if (lenis?.on) {
      lenis.on('scroll', updateHint);
    } else {
      window.addEventListener('scroll', updateHint, { passive: true });
    }
    updateHint();
  }

  // Service area carousel
  const track = document.getElementById('area-track');
  const prevBtn = document.getElementById('area-prev');
  const nextBtn = document.getElementById('area-next');
  if (track && prevBtn && nextBtn) {
    let offset = 0;
    const getCardWidth = () => {
      const card = track.querySelector('.coastal-area-card') as HTMLElement;
      if (!card) return 0;
      return card.offsetWidth + 16; // card width + gap
    };
    const getMaxOffset = () => {
      const visibleWidth = (track.parentElement as HTMLElement).offsetWidth;
      const totalWidth = track.scrollWidth;
      return Math.max(0, totalWidth - visibleWidth);
    };
    prevBtn.addEventListener('click', () => {
      offset = Math.max(0, offset - getCardWidth());
      track.style.transform = `translateX(-${offset}px)`;
    });
    nextBtn.addEventListener('click', () => {
      offset = Math.min(getMaxOffset(), offset + getCardWidth());
      track.style.transform = `translateX(-${offset}px)`;
    });
  }

  const compareMount = document.getElementById('compare-mount');
  if (compareMount) {
    render(h(CompareScroll, null), compareMount);
  }

  // After all Preact islands mount + resources load, refresh ScrollTrigger
  // so the scroll-card components see the final page height.
  window.addEventListener('load', () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
          ScrollTrigger.sort();
          ScrollTrigger.refresh();
        });
      });
    });
  });
</script>

<style>
  /* ====================================================================
     C2 — STICKY CHAPTER MARKER (top-left)
     Fixed in the upper-left of the viewport. Updates as the user scrolls
     past each section. Mono-cap label, matches editorial chapter feel.
     ==================================================================== */
  :global(.oa-nav-marker) {
    position: fixed;
    top: 96px;
    left: 24px;
    z-index: 200;
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 8px 14px;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    border-radius: 4px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    pointer-events: none;
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.oa-nav-marker.is-hidden) {
    opacity: 0;
    transform: translateX(-12px);
  }
  :global(.oa-nav-marker__num) {
    color: var(--color-deep-blue);
    font-weight: 600;
  }
  :global(.oa-nav-marker__sep) {
    color: var(--color-text-muted);
  }
  @media (max-width: 899px) {
    :global(.oa-nav-marker) { display: none; }
  }

  /* ====================================================================
     C3 — SIDE RAIL WITH SECTION DOTS (right edge, vertically centered)
     7 dots, one per major section. Active dot fills, passed dots are
     half-filled, upcoming dots are outlined. Click → lenis.scrollTo().
     ==================================================================== */
  :global(.oa-nav-rail) {
    position: fixed;
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    z-index: 200;
    opacity: 1;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.oa-nav-rail.is-hidden) {
    opacity: 0;
    pointer-events: none;
  }
  :global(.oa-nav-rail__list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  :global(.oa-nav-rail__item) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  :global(.oa-nav-rail__dot) {
    width: 8px;
    height: 8px;
    padding: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.oa-nav-rail__dot:hover) { transform: scale(1.25); }
  :global(.oa-nav-rail__dot-inner) {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent);
    background: transparent;
    transition:
      background 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.oa-nav-rail__dot.is-passed .oa-nav-rail__dot-inner) {
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
    border-color: color-mix(in srgb, var(--color-text) 30%, transparent);
  }
  :global(.oa-nav-rail__dot.is-active .oa-nav-rail__dot-inner) {
    background: var(--color-deep-blue);
    border-color: var(--color-deep-blue);
    transform: scale(1.4);
  }
  :global(.oa-nav-rail__tooltip) {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%) translateX(8px);
    padding: 4px 10px;
    background: var(--color-text);
    color: var(--color-bg);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-radius: 3px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.oa-nav-rail__item:hover .oa-nav-rail__tooltip) {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }
  @media (max-width: 899px) {
    :global(.oa-nav-rail) { display: none; }
  }

  /* ====================================================================
     B2 — NEXT-SECTION HINT
     Tiny "↓ next" cue that fades in at the bottom of long pinned
     sections. Each pinned section uses .oa-section-end-hint.
     Triggered via data-attr toggling from a small script.
     ==================================================================== */
  :global(.oa-section-end-hint) {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 8px);
    z-index: 150;
    padding: 8px 16px;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    border-radius: 999px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.oa-section-end-hint.is-visible) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  :global(.oa-section-end-hint__arrow) {
    display: inline-block;
    margin-right: 6px;
    color: var(--color-deep-blue);
  }

  /* === Section Flow === */
  .oa-section {
    position: relative;
  }

  /* The "Why We Exist" section is a full-bleed dark stage; cancel the
     section's vertical padding so the dark gradient meets the header. */
  .problem-section {
    padding-block: 0;
  }
  .problem-section > .container {
    max-width: none;
    padding-inline: 0;
  }

  /* GPU compositing hints for scroll-animated cards */
  :global(.ps__card),
  :global(.cs__card),
  :global(.vs__card),
  :global(.tl-card) {
    will-change: opacity, transform;
  }

  /* === "Why We Exist" Disconnected → Connected Scroll Section === */
  /* Full-bleed: escapes the .container's max-width so the dark gradient
     fills the viewport edge to edge. */
  :global(.prb) {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  :global(.prb__sticky) {
    position: relative;
    width: 100%;
    height: 100vh;
    background: radial-gradient(ellipse at 50% 50%, #0c4a6e 0%, #0a1929 80%);
    color: #fff;
    overflow: hidden;
  }

  :global(.prb__progress) {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #7dd3fc, #0284c7);
    z-index: 10;
  }

  :global(.prb__fg) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 6vh 2rem 0;
    text-align: center;
    pointer-events: none;
  }

  :global(.prb__kicker) {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7dd3fc;
    margin-bottom: 1rem;
  }

  :global(.prb__headlines) {
    position: relative;
    max-width: 880px;
    min-height: 130px;
    width: 100%;
  }
  :global(.prb__headline) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  :global(.prb__headline h2) {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.1;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: #fff;
  }
  :global(.prb__headline p) {
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.5;
    margin: 0;
    max-width: 600px;
    color: rgba(255, 255, 255, 0.78);
  }
  :global(.prb__headline em) {
    font-style: normal;
  }
  :global(.prb__headline--bad em) { color: #fca5a5; }
  :global(.prb__headline--good em) { color: #7dd3fc; }
  :global(.prb__headline--good) { opacity: 0; }

  :global(.prb__stage) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: clamp(180px, 22vh, 232px);
    padding-bottom: 6vh;
  }
  /* Fixed-design canvas (1100x680 px). It is uniformly scaled to fit the
     available stage area via the --prb-scale CSS variable, set in JS. */
  :global(.prb__canvas) {
    position: relative;
    width: 1100px;
    height: 680px;
    flex-shrink: 0;
    transform: scale(var(--prb-scale, 1));
    transform-origin: center center;
  }
  /* Hidden semicircle "shelf" the cards sit on. Traces the upper half of
     the same ellipse used to position the cards (rx=440, ry=280). */
  :global(.prb__arc) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  :global(.prb__arc path) {
    stroke: rgba(125, 211, 252, 0.45);
    stroke-width: 1.5;
    fill: none;
    opacity: 0;
    filter: drop-shadow(0 0 6px rgba(125, 211, 252, 0.35));
    transition: opacity 0.9s ease-out;
  }
  :global(.prb__arc.is-on path) {
    opacity: 1;
  }

  :global(.prb__node) {
    position: absolute;
    width: 188px;
    height: 90px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 14px;
    padding: 13px 14px;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.6s, background 0.6s, box-shadow 0.6s;
    will-change: transform, opacity;
  }
  :global(.prb__node-row) {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  :global(.prb__node-icon) {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(125, 211, 252, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7dd3fc;
    flex-shrink: 0;
    transition: background 0.6s, color 0.6s;
  }
  :global(.prb__node-icon svg) {
    width: 16px;
    height: 16px;
  }
  :global(.prb__node-title) {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    line-height: 1.1;
  }
  :global(.prb__node-cap) {
    position: relative;
    height: 16px;
  }
  :global(.prb__node-cap-bad),
  :global(.prb__node-cap-good) {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.45s;
  }
  :global(.prb__node-cap-bad) { color: #fca5a5; }
  :global(.prb__node-cap-good) { color: #86efac; opacity: 0; }
  :global(.prb__node-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  :global(.prb__node-dot--bad) {
    background: #ef4444;
    box-shadow: 0 0 6px #ef4444;
  }
  :global(.prb__node-dot--good) {
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  :global(.prb__node.is-good) {
    background: rgba(125, 211, 252, 0.08);
    border-color: rgba(125, 211, 252, 0.4);
    box-shadow: 0 0 24px rgba(125, 211, 252, 0.15);
  }
  :global(.prb__node.is-good .prb__node-cap-bad) { opacity: 0; }
  :global(.prb__node.is-good .prb__node-cap-good) { opacity: 1; }
  :global(.prb__node.is-good .prb__node-icon) {
    background: rgba(34, 197, 94, 0.18);
    color: #86efac;
  }

  /* Logo centerpiece — sits low-center inside the canvas (matches HUB_CX=550,
     HUB_CY=460 in ProblemScroll.tsx). Cards sit on a true circle of radius
     ARC_R=400 around the logo at even 45° angular spacing. */
  :global(.prb__hub) {
    position: absolute;
    left: 50%;
    top: 67.65%; /* 460 / 680 */
    transform: translate(-50%, -50%) scale(0.6);
    width: 540px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition:
      opacity 0.8s ease-out,
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  :global(.prb__hub.is-on) {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  :global(.prb__hub-logo) {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 28px rgba(125, 211, 252, 0.22));
  }

  :global(.prb__hint) {
    position: absolute;
    bottom: 4vh;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.4s;
  }
  :global(.prb__hint.is-hidden) { opacity: 0; }
  :global(.prb__hint svg) {
    width: 14px;
    height: 14px;
    animation: prb-bob 1.6s ease-in-out infinite;
  }
  @keyframes prb-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  :global(.prb__spacer) { height: 400vh; }
  @media (max-width: 899px) {
    :global(.prb__spacer) { height: 300vh; }
  }

  /* === Comparison Scroll Section === */
  .compare-scroll-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  :global(.cs) {
    position: relative;
    margin-top: var(--space-10);
  }

  :global(.cs__sticky) {
    position: sticky;
    top: 100px;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
  }

  :global(.cs__header--mobile) {
    display: block;
    margin-bottom: var(--space-6);
  }

  :global(.cs__header--desktop) {
    display: none;
  }

  :global(.cs__card-stack) {
    position: relative;
  }

  :global(.cs__card) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  :global(.cs__card:first-child) {
    position: relative;
  }

  :global(.cs__card.is-active) {
    pointer-events: auto;
  }

  /* Each compare side gets ~100vh of scroll distance (2 sides × 100vh = 200vh) */
  :global(.cs__spacer) {
    height: 200vh;
  }

  :global(.compare-card) {
    max-width: 700px;
    margin: 0 auto;
    background: #fff;
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
    border: 1px solid #e5e5e5;
    border-radius: var(--radius-lg);
  }

  :global(.compare-side__header) {
    margin-bottom: 2.5rem;
  }

  :global(.compare-label) {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  :global(.compare-label--accent) {
    color: var(--color-cta);
  }

  :global(.compare-title) {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  :global(.compare-title--dark) {
    color: #0B1320;
  }

  :global(.compare-points) {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  :global(.compare-point) {
    display: flex;
    gap: 1.25rem;
  }

  :global(.compare-icon) {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
  }

  :global(.compare-icon--bad) {
    border: 1px solid #fecaca;
    background: #fef2f2;
    color: #ef4444;
  }

  :global(.compare-icon--good) {
    border: 1px solid var(--color-cta);
    background: rgba(224, 182, 41, 0.1);
    color: var(--color-cta);
  }

  :global(.compare-point__title) {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  :global(.compare-point__desc) {
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--color-text-light);
  }

  :global(.compare-bar) {
    margin-top: 0.85rem;
    height: 0.4rem;
    position: relative;
    background: #e5e7eb;
    overflow: hidden;
  }

  :global(.compare-bar--chaotic span) {
    position: absolute;
    top: 0;
    bottom: 0;
    background: #ef4444;
    opacity: 0.55;
  }

  :global(.compare-bar--gaps) {
    display: flex;
    gap: 3px;
    background: transparent;
  }

  :global(.compare-bar--gaps span) {
    flex: 1;
    height: 0.4rem;
    background: #fca5a5;
  }

  :global(.compare-bar--gaps span.empty) {
    background: transparent;
  }

  :global(.compare-bar--solid) {
    background: linear-gradient(to right, rgba(224, 182, 41, 0.4), rgba(224, 182, 41, 0.8));
  }

  :global(.compare-bar--consistent) {
    display: flex;
    gap: 3px;
    background: transparent;
  }

  :global(.compare-bar--consistent span) {
    flex: 1;
    height: 0.4rem;
    background: rgba(224, 182, 41, 0.6);
  }

  .pillars-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  /* === Scroll-Driven Pillars (Preact-rendered, needs :global) === */

  :global(.pillars-interactive__svg) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.1));
  }

  /* Mobile: stacked layout — diagram on top, cards below, scroll still works */
  :global(.ps) {
    margin-top: var(--space-6);
    position: relative;
  }

  :global(.ps__sticky-col) {
    position: sticky;
    top: 50px;
    z-index: 1;
    background: var(--color-bg);
    padding-bottom: 1rem;
  }

  /* Mobile: show the non-sticky header, hide the sticky one */
  :global(.ps__header--mobile) {
    display: block;
    margin-bottom: var(--space-6);
  }

  :global(.ps__header--desktop) {
    display: none;
  }

  /* Mobile: top-row stacks (header above diagram is the natural order;
     keep them stacked tightly so the card-stack below gets max room). */
  :global(.ps__top-row) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-6);
  }

  :global(.ps__diagram) {
    max-width: 220px;
    width: 100%;
  }

  :global(.ps__card) {
    padding: 1.25rem;
  }

  :global(.ps__card-header) {
    gap: 0.65rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.65rem;
  }

  :global(.ps__card-icon) {
    width: 36px;
    height: 36px;
    padding: 6px;
  }

  :global(.ps__card-title) {
    font-size: 1rem;
  }

  :global(.ps__card-body) {
    font-size: 0.85rem;
  }

  :global(.ps__mobile-diagram) {
    display: none;
  }

  /* Card stack — all cards layered, only active visible via crossfade */
  :global(.ps__card-stack) {
    position: relative;
  }

  /* Cards no longer have a container background — content sits directly in
     the right column and GSAP crossfades between pillars as the user scrolls. */
  :global(.ps__card) {
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 1;
  }

  :global(.ps__card:first-child) {
    position: relative;
  }

  /* Active card sits on top of the stack AND receives pointer events,
     so clicks hit it directly without relying on pass-through. */
  :global(.ps__card.is-active) {
    pointer-events: auto;
    z-index: 2;
  }

  /* Scroll spacer — creates scroll distance for the progress calculation */
  /* Each pillar gets ~100vh of scroll distance (4 pillars × 100vh = 400vh) */
  :global(.ps__spacer) {
    height: 400vh;
  }

  :global(.ps__card-header) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0;
    border-bottom: none;
  }

  :global(.ps__card-icon) {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  :global(.ps__card-icon img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  :global(.ps__card-title) {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
  }

  :global(.ps__card-body) {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--color-text-light);
  }

  :global(.ps__card-body p) {
    margin-bottom: 0.75rem;
  }

  /* Desktop: sticky left column (diagram + card), invisible scroll track right */
  @media (min-width: 900px) {
    :global(.ps) {
      display: flex;
      align-items: flex-start;
      position: relative;
    }

    :global(.ps__sticky-col) {
      top: 60px;
      background: var(--color-bg);
    }

    :global(.ps__header--mobile) {
      display: none;
    }

    :global(.ps__header--desktop) {
      display: block;
      /* Margin handled by the top-row gap on desktop. */
      margin-bottom: 0;
    }

    /* Desktop: header on the LEFT, triangle diagram on the RIGHT,
       sitting inline at the top of the sticky col. Card-stack drops
       below as a full-width block so the content-heavy interactive
       pieces (calculator, tabs, diagram) can use the entire section
       width — was previously squeezed into the right ~50% of the row. */
    :global(.ps__top-row) {
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
      margin-bottom: var(--space-6);
    }

    :global(.ps__top-row .section-header) {
      flex: 1;
      text-align: left;
      margin-bottom: 0;
    }

    :global(.ps__diagram) {
      flex: 0 0 auto;
      width: clamp(220px, 26vw, 320px);
      max-width: none;
      align-self: center;
    }

    :global(.ps__card-stack) {
      width: 100%;
    }

    :global(.cs__header--mobile) {
      display: none;
    }

    :global(.cs__header--desktop) {
      display: block;
      margin-bottom: var(--space-8);
    }
  }

  /* === Mobile overrides for comparison section === */
  @media (max-width: 899px) {
    :global(.cs) {
      margin-top: var(--space-6);
    }

    :global(.cs__sticky) {
      top: 50px;
    }

    /* compare headers already handled by global defaults */

    :global(.compare-card) {
      padding: 1.25rem;
    }

    :global(.compare-points) {
      gap: 1.5rem;
    }

    :global(.compare-point__title) {
      font-size: 0.85rem;
    }

    :global(.compare-point__desc) {
      font-size: 0.8rem;
    }

    :global(.cs__spacer) {
      height: 120vh;
    }
  }

  /* === Mobile overrides for pillar cards (after global card styles) === */
  @media (max-width: 899px) {
    /* ps__header visibility handled by --mobile/--desktop toggle */

    :global(.ps__card) {
      padding: 1.25rem !important;
    }

    :global(.ps__spacer) {
      height: 300vh;
    }

    :global(.ps__card-header) {
      gap: 0.65rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.65rem;
    }

    :global(.ps__card-icon) {
      width: 36px;
      height: 36px;
      padding: 6px;
    }

    :global(.ps__card-title) {
      font-size: 1rem;
    }

    :global(.ps__card-body) {
      font-size: 0.85rem;
    }

    :global(.ps__card-body p) {
      margin-bottom: 0.5rem;
    }
  }

  /* ========================================
     Coastal Expertise Section + Service Area Cards
     ======================================== */
  .coastal-wave {
    position: relative;
    z-index: 2;
    line-height: 0;
  }

  .coastal-wave svg {
    width: 100%;
    height: 64px;
    display: block;
  }

  .coastal-wave--top {
    margin-bottom: -1px;
    margin-top: var(--space-8);
  }

  .coastal-wave--bottom {
    margin-top: -1px;
    transform: rotate(180deg);
  }

  .coastal-section {
    background: #1E3A5F;
    color: #fff;
    padding: var(--space-16) 0;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .coastal-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .coastal-layout {
      flex-direction: row;
      gap: 4rem;
    }

    .coastal-wave svg {
      height: 96px;
    }
  }

  @media (min-width: 1100px) {
    .coastal-wave svg {
      height: 120px;
    }
  }

  /* Map graphic */
  .coastal-map {
    flex: 0 0 auto;
    width: 100%;
    max-width: 400px;
    position: relative;
  }

  @media (min-width: 900px) {
    .coastal-map {
      flex: 0 0 45%;
      max-width: none;
    }
  }

  .coastal-map__glow {
    position: absolute;
    inset: -10%;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    filter: blur(40px);
  }

  .coastal-map__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.12);
    background: rgba(30, 40, 60, 0.5);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
  }

  .coastal-map__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.7s ease;
  }

  .coastal-map__frame:hover .coastal-map__img {
    opacity: 0.75;
  }

  .coastal-map__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top right, rgba(30, 58, 95, 0.2), transparent);
  }

  .coastal-map__pin {
    position: absolute;
    top: 42%;
    left: 55%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .coastal-map__pulse {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E28D33;
    margin-top: 2px;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.5); }
  }

  @media (prefers-reduced-motion: reduce) {
    .coastal-map__pulse {
      animation: none;
    }
  }

  /* Content */
  .coastal-content {
    flex: 1;
  }

  .coastal-content__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 1rem;
  }

  .coastal-content__desc {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    line-height: 1.65;
    color: rgba(226, 232, 240, 0.9);
    max-width: 500px;
    margin-bottom: 2rem;
  }

  .coastal-checklist {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .coastal-checklist__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .coastal-checklist__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(226, 141, 51, 0.2);
    color: #E28D33;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    transition: background 200ms ease, color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .coastal-checklist__item:hover .coastal-checklist__icon {
      background: #E28D33;
      color: #fff;
    }
  }

  .coastal-checklist__item strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .coastal-checklist__item span {
    display: block;
    font-size: 0.85rem;
    color: rgba(203, 213, 225, 0.85);
    line-height: 1.5;
  }

  /* --- Service Area Carousel --- */
  .coastal-areas {
    margin-top: 3.5rem;
  }

  .coastal-areas__title {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 1.25rem;
  }

  .coastal-areas__nav {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .coastal-areas__btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .coastal-areas__btn:hover {
      background: rgba(255, 255, 255, 0.18);
      color: #fff;
      border-color: rgba(226, 141, 51, 0.5);
    }
  }

  .coastal-areas__track-wrapper {
    overflow: hidden;
  }

  .coastal-areas__track {
    display: flex;
    gap: 1rem;
    transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .coastal-area-card {
    flex: 0 0 calc(50% - 0.5rem);
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  @media (min-width: 600px) {
    .coastal-area-card {
      flex: 0 0 calc(33.333% - 0.67rem);
    }
  }

  @media (min-width: 900px) {
    .coastal-area-card {
      flex: 0 0 calc(25% - 0.75rem);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .coastal-area-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      color: #fff;
    }
  }

  .coastal-area-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .coastal-area-card:hover .coastal-area-card__img {
      transform: scale(1.06);
    }
  }

  .coastal-area-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.1) 50%, transparent 100%);
  }

  .coastal-area-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .coastal-area-card__label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #E28D33;
  }

  .coastal-area-card__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.2;
    color: #fff;
  }

  /* ========================================
     Visit Section — Anatomy of a Visit
     ======================================== */
  .visit-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  :global(.vs) {
    margin-top: var(--space-6);
    position: relative;
  }

  :global(.vs__eyebrow) {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2563eb;
    margin-bottom: 0.5rem;
  }

  :global(.vs__sticky-col) {
    position: sticky;
    top: 50px;
    z-index: 1;
    padding-bottom: 1rem;
  }

  /* Mobile header visible, desktop hidden */
  :global(.vs__header--mobile) {
    display: block;
    margin-bottom: var(--space-6);
  }

  :global(.vs__header--desktop) {
    display: none;
  }

  :global(.vs__content-row) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* --- Timeline indicator --- */
  :global(.vs__timeline) {
    display: none; /* hidden on mobile */
  }

  /* --- Card stack --- */
  :global(.vs__card-stack) {
    position: relative;
  }

  :global(.vs__card) {
    background: #fff;
    border-radius: var(--radius-lg);
    border: 2px solid #e5e7eb;
    border-left-width: 4px;
    padding: 2rem;
    box-shadow: var(--shadow-md);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  :global(.vs__card:first-child) {
    position: relative;
  }

  :global(.vs__card.is-active) {
    pointer-events: auto;
  }

  :global(.vs__card-header) {
    margin-bottom: 1rem;
  }

  :global(.vs__card-badge) {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid;
    margin-bottom: 0.75rem;
  }

  :global(.vs__card-title) {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
  }

  :global(.vs__card-body) {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--color-text-light);
  }

  :global(.vs__card-body p) {
    margin-bottom: 0.75rem;
  }

  :global(.vs__spacer) {
    height: 300vh;
  }

  /* --- Desktop layout --- */
  @media (min-width: 900px) {
    :global(.vs__sticky-col) {
      top: 80px;
    }

    :global(.vs__header--mobile) {
      display: none;
    }

    :global(.vs__header--desktop) {
      display: block;
      margin-bottom: var(--space-8);
    }

    :global(.vs__content-row) {
      flex-direction: row;
      align-items: flex-start;
      gap: 3rem;
    }

