---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicePageFinale from '../../components/ServicePageFinale.astro';

const base = import.meta.env.BASE_URL;

const faqs = [
  { question: 'What types of commercial pools do you service?', answer: 'We maintain pools for HOA communities, hotels and motels, apartment complexes, fitness centers, and short-term rental properties throughout the Greater Savannah area.' },
  { question: 'Do you handle health department compliance?', answer: 'Yes. We maintain chemical logs, testing schedules, and service documentation formatted exactly how Georgia DPH inspectors expect to see them. When they show up, you hand them our logs.' },
  { question: 'Can you work around our facility hours?', answer: 'Absolutely. We offer flexible scheduling including early morning, evening, and weekend service times to minimize disruption to your guests and residents.' },
  { question: 'How do you handle high-traffic pools?', answer: 'Higher bather loads mean more contaminants. We adjust testing frequency and chemical dosing based on your actual usage patterns—not a one-size-fits-all schedule.' },
  { question: 'What happens if our regular tech is unavailable?', answer: 'Someone else on the team covers the route—same day, same service standards. Commercial properties can\'t wait, and we don\'t make you.' },
  { question: 'How does commercial pricing work?', answer: 'Pricing is based on pool size, visit frequency, and specific compliance requirements. Contact us for a consultation and custom quote for your property.' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Commercial Pool Cleaning",
    "provider": { "@type": "LocalBusiness", "name": "Perfect Pools" },
    "areaServed": "Savannah, Richmond Hill, Coastal Georgia",
    "priceRange": "Contact for pricing"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<BaseLayout
  title="Commercial Pool Cleaning in Savannah & Richmond Hill GA | Perfect Pools"
  description="Professional commercial pool maintenance for HOAs, hotels, apartments, and short-term rentals. Health department compliant documentation, 24hr response time. Serving Coastal Georgia."
  canonicalPath="/services/commercial-pool-cleaning/"
  schema={schema}
>
  <!-- Hero · Photo IS the hero. Title + subtitle + CTA overlay the
       image (middle-left). Stats overlay the bottom of the image.
       No separate blue gradient section. -->
  <section class="cph-hero">
    <div class="cph-hero__media">
      <img
        src={`${base}images/commercial-hero.jpg`}
        alt="Perfect Pools technician servicing a commercial pool"
        loading="eager"
        width="2400"
        height="1600"
      />

      {/* Title + CTA, anchored to middle-LEFT of the photo. (The
          subtitle that used to live here was moved to its own
          statement section below the pillars — see `.cph-statement`
          below — so it gets dedicated space and breathing room
          before the Maintenance Plans chapter.) */}
      <div class="cph-hero__content">
        <h1 class="cph-hero__title">Commercial Pool Care</h1>
        <button type="button" class="cph-hero__cta" data-open-intake>Schedule a Consultation</button>
      </div>

      {/* Stats overlay — sits at the BOTTOM of the hero image. Numbers
          count up from 0 → target with a decelerating curve when the
          section scrolls into view. Driven by the inline script below. */}
      <div class="cph-stats" data-cph-stats>
        <div class="cph-stat">
          <div class="cph-stat__value">
            <span class="cph-stat__num" data-count-to="75">0</span>
            <span class="cph-stat__suffix">+</span>
          </div>
          <div class="cph-stat__label">Commercial pools serviced</div>
        </div>
        <div class="cph-stat">
          <div class="cph-stat__value">
            <span class="cph-stat__prefix">#</span>
            <span class="cph-stat__num" data-count-to="1">0</span>
          </div>
          <div class="cph-stat__label">
            Commercial pool service provider across coastal counties
            <span class="cph-stat__footnote">Per publicly available DPH inspection records</span>
          </div>
        </div>
        <div class="cph-stat">
          <div class="cph-stat__value">
            <span class="cph-stat__num" data-count-to="98">0</span>
            <span class="cph-stat__suffix">%+</span>
          </div>
          <div class="cph-stat__label">Avg DPH inspection score</div>
        </div>
        <div class="cph-stat">
          <div class="cph-stat__value">
            <span class="cph-stat__num" data-count-to="24">0</span>
            <span class="cph-stat__suffix">hr</span>
          </div>
          <div class="cph-stat__label">Service response time</div>
        </div>
      </div>
    </div>
  </section>

  {/* Stats bar was removed in v2 — the same 4 numbers now live as
      the overlay on the hero image above. */}

  <!-- Two main commercial priorities — Rivian Delivery 500/700 style:
       no section header; each column's TITLE acts as the header,
       icon sits below it, description below the icon. -->
  <section class="section cph-pillars">
    <div class="container">
      <div class="cph-pillars__grid">
        <article class="cph-pillar">
          <h3 class="cph-pillar__title">Safety-first pool management</h3>
          {/* Two safety signs side-by-side inside one media tile. */}
          <div class="cph-pillar__media cph-pillar__media--signs">
            <img
              src={`${base}images/emergency-911-sign.png`}
              alt="Commercial pool 911 emergency phone number sign"
              loading="lazy"
              class="cph-pillar__sign--911"
            />
            <img
              src={`${base}images/safety-max-bather-load.webp`}
              alt="Maximum bather load posting"
              loading="lazy"
            />
          </div>
          <p class="cph-pillar__desc">
            We prioritize safety signage, proper chemical balance, and compliance protocols that
            protect families using the pool while reducing liability for property owners and
            managers.
          </p>
        </article>

        <article class="cph-pillar">
          <h3 class="cph-pillar__title">Built for property managers and HOA boards</h3>
          {/* 3×2 grid of partner property-manager logos. First two
              cells are filled; remaining four are placeholders the
              user will fill as more logos arrive. */}
          <div class="cph-pillar__logos">
            <div class="cph-pillar__logo-cell">
              <img
                src={`${base}images/property-managers/hodnett-cooper.png`}
                alt="Hodnett Cooper Vacation Rentals"
                loading="lazy"
              />
            </div>
            <div class="cph-pillar__logo-cell">
              <img
                src={`${base}images/property-managers/keystone-association-managers.webp`}
                alt="Keystone Association Managers"
                loading="lazy"
              />
            </div>
            <div class="cph-pillar__logo-cell">
              <img
                src={`${base}images/property-managers/psm-premier.jpeg`}
                alt="PSM Premier Services and Management"
                loading="lazy"
              />
            </div>
            <div class="cph-pillar__logo-cell">
              <img
                src={`${base}images/property-managers/elite-coastal.png`}
                alt="Elite Coastal Management"
                loading="lazy"
              />
            </div>
            <div class="cph-pillar__logo-cell">
              <img
                src={`${base}images/property-managers/partner-5.avif`}
                alt="Partner property manager"
                loading="lazy"
              />
            </div>
            <div class="cph-pillar__logo-cell">
              <img
                src={`${base}images/property-managers/firstservice-residential.jpeg`}
                alt="FirstService Residential"
                loading="lazy"
              />
            </div>
          </div>
          <p class="cph-pillar__desc">
            We work directly with property managers, boards, and maintenance teams to streamline
            communication, schedule service efficiently, and keep facilities inspection-ready.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* Standalone "What every visit includes" section was removed —
      content was consolidated into the Maintenance Plans tabs above
      (What's Included tab). */}

  {/* === Statement section ===========================================
       A quiet centered statement that bridges the hero/pillars block
       above and the dense Maintenance Plans chapter below. Pulled
       out of the hero subtitle slot so it gets the full vertical
       breathing room of its own section — same pattern as Rivian's
       "Sustainable, cost-effective..." statement that sits between
       their hero and their detail chapters. */}
  <section class="cph-statement">
    <div class="container">
      <p class="cph-statement__text">
        Health department documentation, reliable service, and one point of contact. So you can focus on your property, not your pool.
      </p>
    </div>
  </section>

  <!-- ────────────────────────────────────────────────────────────────
       Maintenance Plans CHAPTER. Wraps the nav + the dark section so
       the nav can be `position: sticky` and pin to the viewport top
       ONLY while the chapter is on-screen. Once you scroll past the
       wrapper, the nav un-sticks naturally. While the chapter is
       "active" (its top edge is at/above the viewport top), a JS
       scroll handler toggles `body.is-mp-chapter`, which hides the
       main site header so the mp-nav can take over as the new
       sticky top — same pattern as the Rivian Fleet page. -->
  <div class="mp-chapter">
  <!-- Maintenance Plans nav — its own component, sits ABOVE the dark
       content section. Same pattern as the Rivian Fleet header: white
       row with brand on the LEFT, section links in the MIDDLE, CTA on
       the RIGHT. Anchor links (`href="#section-id"`) jump to the matching
       <section> below in the chapter — click handler intercepts for
       smooth-scroll w/ nav-height offset; IntersectionObserver drives
       the `.is-active` underline based on which section is in view. -->
  <nav class="mp-nav" aria-label="Maintenance plan sections">
    <div class="container mp-nav__inner">
      <a class="mp-nav__brand is-active" href="#intro" data-target="intro" aria-label="Maintenance plans — jump to intro">Maintenance plans</a>

      <div class="mp-nav__tabs">
        <a class="mp-nav__tab" href="#included" data-target="included">What's Included</a>
        <a class="mp-nav__tab" href="#compliance" data-target="compliance">Compliance</a>
        <a class="mp-nav__tab" href="#pricing" data-target="pricing">Pricing</a>
        <a class="mp-nav__tab" href="#properties" data-target="properties">Properties We Service</a>
      </div>

      <button type="button" class="mp-nav__cta" data-open-intake>Schedule a Consultation</button>
    </div>
  </nav>

  <!-- Maintenance Plans content — each former tab is now its own
       <section> with an id. The mp-nav links above use `href="#X"`
       to jump to these. All 5 sections share the dark navy bg via
       `.mp-chapter` (the wrapper), so there's no per-section bg
       declaration needed. Each section sets `scroll-margin-top` so
       smooth-scroll lands the section's top BELOW the sticky nav,
       not behind it. -->

  {/* === Intro — narrow dark high-level summary =====================
       The first section under the maintenance-plans nav. Explains
       what a commercial pool maintenance plan is, why it's required,
       and a 3-pillar high-level summary of what we cover. Narrow
       (~60vh) so it reads as an introduction rather than a full
       feature section. */}
  <section id="intro" class="mp-section mp-section--intro mp-section--dark mp-section--narrow">
    <div class="container">
          <header class="mp-panel-head">
            <span class="mp-panel-head__kicker">Maintenance plans</span>
            <h3>A year-round service contract that keeps your pool inspection-ready.</h3>
            <p>Commercial pools are a Georgia Department of Public Health regulated facility, not optional infrastructure. A maintenance plan is a fixed weekly schedule for chemistry, equipment, documentation, and emergency response — handled by certified pool operators so your team never has to think about it.</p>
          </header>
          <ul class="mp-intro-pillars">
            <li class="mp-intro-pillar">
              <span class="mp-intro-pillar__icon mp-intro-pillar__icon--badge" aria-hidden="true">
                <img src={`${base}images/cpo-certified.png`} alt="" loading="lazy" width="700" height="700" />
              </span>
              <strong>Certified pool operators</strong>
              <span>State-licensed CPOs on every account</span>
            </li>
            <li class="mp-intro-pillar">
              {/* Calendar + clock illustration — represents the
                  year-round / scheduled weekly visit cadence. */}
              <span class="mp-intro-pillar__icon mp-intro-pillar__icon--image" aria-hidden="true">
                <img src={`${base}images/icon-schedule.png`} alt="" loading="lazy" width="512" height="512" />
              </span>
              <strong>Year-round coverage</strong>
              <span>2&ndash;7 visits per week, scheduled to your operation</span>
            </li>
            <li class="mp-intro-pillar">
              {/* Shield + document illustration — represents our
                  liability insurance coverage protecting client
                  properties during service. */}
              <span class="mp-intro-pillar__icon mp-intro-pillar__icon--image" aria-hidden="true">
                <img src={`${base}images/icon-insurance.png`} alt="" loading="lazy" width="512" height="512" />
              </span>
              <strong>Fully insured</strong>
              <span>Liability coverage up to $1,000,000 per occurrence</span>
            </li>
          </ul>
    </div>
  </section>

  {/* === What's Included ============================================
       This section is on a LIGHT background and holds TWO stacked
       sub-blocks (both formerly separate sections):

         1. Full-service management — 4-card photo grid showing the
            pillars of our commercial service (Bulk chemicals,
            Equipment rooms, Health department, Reliable coverage).
            Sits on the section's white bg, hover-reveal description
            inside each card.

         2. Every visit includes — pill→section reveal animation
            that expands a small dark pill into a full-section dark
            backdrop containing the 8-card service checklist.

       The pill animation's data-included-reveal trigger moves from
       the `<section>` to the `<div class="mp-included-shell">` so
       the pill triggers based on the SHELL's scroll position — i.e.
       it kicks in once the user reaches the every-visit half of
       the section, not when they first enter the section. */}
  <section id="included" class="mp-section mp-section--included mp-section--light">

    {/* — Sub-block 1: Full-service management — scroll-pinned carousel.
         The HEADER + CAROUSEL both live inside the same sticky pin
         viewport, so the header stays visible the entire time the
         user is scrolling through the carousel's pin region (not
         just a moment before it). As the user scrolls VERTICALLY
         through .mp-included-pin's tall outer height, the sticky
         viewport pins both elements to the top and the carousel's
         track translates HORIZONTALLY, advancing through the slides.
         Once vertical scroll exceeds the pin region's scrollable
         range, the pin releases and normal vertical scroll resumes —
         the carousel has "run out" of slides. Driven by the script
         below; `data-prop-pinned` tells the shared carousel handler
         to skip this instance so it doesn't fight the pin scroll. */}
    <div class="mp-included-pin">
      <div class="mp-included-pin__viewport">
        <header class="mp-panel-head mp-included-pin__head">
          <span class="mp-panel-head__kicker">Full-service management</span>
          <h3>We handle everything so you don't have to</h3>
          <p>Commercial pool management goes beyond weekly cleaning. We take the entire operation off your plate.</p>
        </header>
        <div class="mp-prop-carousel mp-prop-carousel--reveal mp-prop-carousel--pinned" data-prop-carousel data-prop-pinned>
      <div class="mp-prop-carousel__track" data-prop-track>
        <article class="mp-prop-slide mp-prop-slide--reveal">
          <img class="mp-prop-slide__photo" src={`${base}images/bulk-chlorine.jpg`} alt="Bulk chlorine delivery for commercial pools" loading="lazy" />
          <div class="mp-prop-slide__scrim" aria-hidden="true"></div>
          <div class="mp-prop-slide__content">
            <h4 class="mp-prop-slide__label">Bulk Chemicals</h4>
            <div class="mp-prop-slide__detail">
              <p>We monitor your levels and deliver in bulk before you run low&mdash;no emergency runs, no retail markup.</p>
              <ul class="mp-prop-slide__points">
                <li>Bulk pricing saves up to 30% vs. store-bought</li>
                <li>We deliver, store, and manage inventory</li>
                <li>Never run out mid-season again</li>
              </ul>
            </div>
          </div>
        </article>

        <article class="mp-prop-slide mp-prop-slide--reveal">
          <img class="mp-prop-slide__photo" src={`${base}images/commercial-pump-room.webp`} alt="Inside a clean, organized commercial pool pump room" loading="lazy" />
          <div class="mp-prop-slide__scrim" aria-hidden="true"></div>
          <div class="mp-prop-slide__content">
            <h4 class="mp-prop-slide__label">Equipment Rooms</h4>
            <div class="mp-prop-slide__detail">
              <p>Your pump room reflects your property. We keep chemical storage organized, equipment labeled, and the space ready for any walkthrough.</p>
              <ul class="mp-prop-slide__points">
                <li>Chemical storage organized and labeled</li>
                <li>No cluttered shelves or leaking jugs</li>
                <li>Professional appearance for inspectors</li>
              </ul>
            </div>
          </div>
        </article>

        <article class="mp-prop-slide mp-prop-slide--reveal">
          <img class="mp-prop-slide__photo" src={`${base}images/pool-water-testing.jpg`} alt="Water testing for health department compliance" loading="lazy" />
          <div class="mp-prop-slide__scrim" aria-hidden="true"></div>
          <div class="mp-prop-slide__content">
            <h4 class="mp-prop-slide__label">Health Department</h4>
            <div class="mp-prop-slide__detail">
              <p>When DPH shows up, you hand them our logs&mdash;that's it. We maintain documentation, handle follow-ups, and keep you in compliance.</p>
              <ul class="mp-prop-slide__points">
                <li>Georgia DPH-formatted chemical logs</li>
                <li>We handle inspector questions directly</li>
                <li>Zero compliance headaches for you</li>
              </ul>
            </div>
          </div>
        </article>

        <article class="mp-prop-slide mp-prop-slide--reveal">
          <img class="mp-prop-slide__photo" src={`${base}images/reliable-coverage.jpg`} alt="Pool technician providing reliable on-site service" loading="lazy" />
          <div class="mp-prop-slide__scrim" aria-hidden="true"></div>
          <div class="mp-prop-slide__content">
            <h4 class="mp-prop-slide__label">Reliable Coverage</h4>
            <div class="mp-prop-slide__detail">
              <p>Tech calls in sick? Someone else covers the route&mdash;same day, same standards. One point of contact, full backup coverage.</p>
              <ul class="mp-prop-slide__points">
                <li>Same-day backup if your tech is out</li>
                <li>Supervisor oversight on every route</li>
                <li>One dedicated point of contact</li>
              </ul>
            </div>
          </div>
        </article>
      </div>

      <div class="mp-prop-carousel__nav">
        <button class="mp-prop-carousel__arrow" type="button" data-prop-prev aria-label="Previous service">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="mp-prop-carousel__dots" data-prop-dots>
          <button class="mp-prop-carousel__dot is-active" type="button" data-prop-page="0" aria-label="Bulk Chemicals"></button>
          <button class="mp-prop-carousel__dot" type="button" data-prop-page="1" aria-label="Equipment Rooms"></button>
          <button class="mp-prop-carousel__dot" type="button" data-prop-page="2" aria-label="Health Department"></button>
          <button class="mp-prop-carousel__dot" type="button" data-prop-page="3" aria-label="Reliable Coverage"></button>
        </div>
        <button class="mp-prop-carousel__arrow" type="button" data-prop-next aria-label="Next service">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
        </div>{/* /.mp-prop-carousel--pinned */}
      </div>{/* /.mp-included-pin__viewport */}
    </div>{/* /.mp-included-pin */}

    {/* — Sub-block 2: Every visit includes — pill-reveal animation — */}
    <div class="mp-included-shell" data-included-reveal>
      <div class="container">
          <header class="mp-panel-head">
            <h3>Every visit includes</h3>
            <p>A repeatable, documented service checklist — performed the same way at every property, every visit.</p>
          </header>
          <div class="mp-grid mp-grid--included" data-included-grid>
            <div class="mp-grid__viewport">
              <div class="mp-grid__tape" data-included-tape>
                <div class="mp-grid__col">
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <img src={`${base}images/icons/test-tubes.svg`} width="32" height="32" alt="" />
                    </div>
                    <h4>Water testing</h4>
                    <p>pH, chlorine, alkalinity, stabilizer, and hardness tested every visit.</p>
                  </div>
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <img src={`${base}images/icons/chemical.svg`} width="32" height="32" alt="" />
                    </div>
                    <h4>Chemistry adjustment</h4>
                    <p>Dosed to exact readings with commercial-grade chemicals, fully logged.</p>
                  </div>
                </div>
                <div class="mp-grid__col">
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <img src={`${base}images/icons/motor.svg`} width="32" height="32" alt="" />
                    </div>
                    <h4>Equipment monitoring</h4>
                    <p>Pumps, filters, heaters, and feeders checked for proper operation.</p>
                  </div>
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <img src={`${base}images/icons/skimmer-net.svg`} width="32" height="32" alt="" />
                    </div>
                    <h4>Surface cleaning</h4>
                    <p>Skim, brush the tile line, and empty baskets every single visit.</p>
                  </div>
                </div>
                <div class="mp-grid__col">
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <img src={`${base}images/icons/pool-brush.svg`} width="32" height="32" alt="" />
                    </div>
                    <h4>Brush walls &amp; tile</h4>
                    <p>Prevents algae buildup and calcium deposits on commercial surfaces.</p>
                  </div>
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <img src={`${base}images/icons/vacuum.svg`} width="32" height="32" alt="" />
                    </div>
                    <h4>Vacuum</h4>
                    <p>Removes dirt, debris, and settled contaminants from the pool floor.</p>
                  </div>
                </div>
                <div class="mp-grid__col">
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="5" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
                    </div>
                    <h4>Chemical log</h4>
                    <p>Readings and adjustments formatted for health department inspections.</p>
                  </div>
                  <div class="mp-card">
                    <div class="mp-card__icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 12h4"/><path d="M10 16h4"/></svg>
                    </div>
                    <h4>Digital report</h4>
                    <p>Photos, notes, and readings sent to your property manager portal.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mp-grid-nav" data-included-nav>
            <button class="mp-grid-nav__arrow" type="button" data-included-prev aria-label="Show first six">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div class="mp-grid-nav__dots">
              <button class="mp-grid-nav__dot is-active" type="button" data-included-page="0" aria-label="Show items 1 through 6"></button>
              <button class="mp-grid-nav__dot" type="button" data-included-page="1" aria-label="Show items 3 through 8"></button>
            </div>
            <button class="mp-grid-nav__arrow" type="button" data-included-next aria-label="Show last six">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
      </div>{/* /.container */}
    </div>{/* /.mp-included-shell */}
  </section>

  {/* === Compliance ================================================
       Simple timed reveal — when the section is fully in viewport, an
       IntersectionObserver adds the `.is-revealed` class to the
       crossfade root after a short hold. A CSS transition then
