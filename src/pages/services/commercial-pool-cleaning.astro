  {/* Sticky-chapter scroll handler. Toggles body.is-mp-chapter while
      the maintenance-plans chapter is the "current view" (its top has
      reached/passed the viewport top, and its bottom hasn't yet). The
      body class is what hides the main site header so the mp-nav (now
      sticky to viewport top) can act as the in-chapter header — same
      handoff pattern as the Rivian Fleet page. */}
  <script>
    (function() {
      const chapter = document.querySelector('.mp-chapter');
      if (!chapter) return;
      let ticking = false;
      function update() {
        const rect = chapter.getBoundingClientRect();
        // "Active" once the chapter's top is at or above the viewport top
        // AND we haven't scrolled past its bottom.
        const inChapter = rect.top <= 0 && rect.bottom > 0;
        document.body.classList.toggle('is-mp-chapter', inChapter);
        ticking = false;
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update(); // initial state on page load
    })();
  </script>

  <script>
    (function() {
      const track = document.getElementById('carouselTrack');
      const dots = document.querySelectorAll('#carouselDots .manage-carousel__dot');
      const prev = document.getElementById('carouselPrev');
      const next = document.getElementById('carouselNext');
      const slides = track.querySelectorAll('.manage-slide');
      let current = 0;

      // Step = the on-screen distance between slide N and slide N+1. We
      // measure it at click-time so the carousel survives window resizes
      // and the mobile→desktop slide-width switch in CSS.
      function getStep() {
        if (slides.length < 2) return slides[0] ? slides[0].offsetWidth : 0;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
        return slides[0].offsetWidth + gap;
      }

      // Max translation = how far we can slide before the LAST slide's right
      // edge would pull away from the carousel's right edge. Clamping to this
      // means the final stop right-aligns the last slide (with the previous
      // slide peeking on the left), instead of leaving whitespace.
      function getMaxTranslate() {
        const container = track.parentElement; // .manage-carousel
        const trackWidth = track.scrollWidth;
        return Math.max(0, trackWidth - container.clientWidth);
      }

      function goTo(index) {
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        current = index;
        const raw = current * getStep();
        const translate = Math.min(raw, getMaxTranslate());
        track.style.transform = `translateX(-${translate}px)`;
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
      }

      prev.addEventListener('click', () => goTo(current - 1));
      next.addEventListener('click', () => goTo(current + 1));
      dots.forEach(dot => {
        dot.addEventListener('click', () => goTo(parseInt(dot.dataset.slide)));
      });

      // Re-snap on resize so the current slide stays correctly aligned.
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => goTo(current), 120);
      });

      // Auto-advance every 6 seconds
      let autoplay = setInterval(() => goTo(current + 1), 6000);
      const carousel = document.getElementById('manageCarousel');
      carousel.addEventListener('mouseenter', () => clearInterval(autoplay));
      carousel.addEventListener('mouseleave', () => {
        autoplay = setInterval(() => goTo(current + 1), 6000);
      });

      // Touch/swipe support
      let touchStartX = 0;
      track.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
      track.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) goTo(current + (diff > 0 ? 1 : -1));
      }, { passive: true });
    })();
  </script>

  {/* ────────────────────────────────────────────────────────────────
       Properties carousel — drives the dots + arrow buttons that sit
       below the full-bleed scroll-snap track. The track itself uses
       native CSS scroll-snap, so all we need from JS is:
         - On arrow/dot click: scroll the track to a slide's position
         - On scroll: detect which slide is currently centered and
           update the active dot accordingly
       We use `scrollTo({ behavior: 'smooth' })` so the browser
       animates the scroll. No translateX, no tape transforms — the
       track is a real scroll container. */}
  <script>
    /* Photo carousel handler — runs for EVERY `[data-prop-carousel]`
       element on the page, not just the first. Lets the same component
       be used in multiple sections (currently: Full-service management
       inside #included, AND Properties We Service inside #properties).
       Each carousel keeps its own state by closing over its own
       `current` inside the forEach callback. */
    (function () {
      // Exclude pinned carousels — they're driven by a separate
      // scroll-pin handler (further down) that translates the track
      // via transform: translateX based on outer page scroll. Letting
      // the scroll-snap handler also touch them would conflict.
      const carousels = document.querySelectorAll('[data-prop-carousel]:not([data-prop-pinned])');
      carousels.forEach((carousel) => {
        const track = carousel.querySelector('[data-prop-track]');
        const slides = Array.from(carousel.querySelectorAll('.mp-prop-slide'));
        const dots = Array.from(carousel.querySelectorAll('[data-prop-page]'));
        const prev = carousel.querySelector('[data-prop-prev]');
        const next = carousel.querySelector('[data-prop-next]');
        if (!track || !slides.length) return;
        let current = 0;
        // While a programmatic scroll (from arrow/dot click) is in
        // flight, suppress the onScroll-driven active-dot detection.
        // Otherwise smooth-scrolling can briefly land on a different
        // slide's center than the one the user clicked, causing the
        // active dot to flip away from the clicked one before
        // settling. Cleared via timeout after the smooth scroll
        // should have settled (~600ms is the browser default).
        let suppressScrollDetect = false;
        let suppressTimer = null;

        // Scroll the track so slide N is centered in the viewport.
        function goTo(index) {
          if (index < 0) index = 0;
          if (index >= slides.length) index = slides.length - 1;
          const slide = slides[index];
          // Compute the scroll position that centers the slide within
          // the track's clientWidth. slide.offsetLeft is relative to
          // the track (its offsetParent), and we shift left so the
          // slide's center aligns with the track's center.
          const target = slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2;
          // Lock the active dot to the clicked index for the duration
          // of the scroll — onScroll won't try to recompute "closest
          // centered slide" during this window.
          suppressScrollDetect = true;
          clearTimeout(suppressTimer);
          suppressTimer = setTimeout(() => { suppressScrollDetect = false; }, 700);
          track.scrollTo({ left: target, behavior: 'smooth' });
        }

        function setActive(index) {
          current = index;
          dots.forEach((d) => {
            d.classList.toggle('is-active', parseInt(d.getAttribute('data-prop-page'), 10) === index);
          });
          if (prev) prev.disabled = index === 0;
          if (next) next.disabled = index === slides.length - 1;
        }

        // Detect which slide is currently the most centered in the
        // track's viewport, and update active dot. Throttled with rAF
        // so it doesn't fire on every scroll event.
        let ticking = false;
        function onScroll() {
          if (ticking) return;
          // Skip detection while a programmatic scroll is settling —
          // setActive was already called with the user's intent before
          // goTo started, so we trust that until the scroll completes.
          if (suppressScrollDetect) return;
          ticking = true;
          requestAnimationFrame(() => {
            const center = track.scrollLeft + track.clientWidth / 2;
            let closest = 0;
            let closestDist = Infinity;
            slides.forEach((s, i) => {
              const slideCenter = s.offsetLeft + s.clientWidth / 2;
              const dist = Math.abs(center - slideCenter);
              if (dist < closestDist) { closestDist = dist; closest = i; }
            });
            if (closest !== current) setActive(closest);
            ticking = false;
          });
        }

        dots.forEach((d) => {
          d.addEventListener('click', () => {
            const i = parseInt(d.getAttribute('data-prop-page'), 10);
            setActive(i);
            goTo(i);
          });
        });
        if (prev) prev.addEventListener('click', () => { const i = current - 1; setActive(Math.max(0, i)); goTo(i); });
        if (next) next.addEventListener('click', () => { const i = current + 1; setActive(Math.min(slides.length - 1, i)); goTo(i); });
        track.addEventListener('scroll', onScroll, { passive: true });

        setActive(0);
      });
    })();
  </script>

  {/* ────────────────────────────────────────────────────────────────
       Scroll pins migrated to GSAP ScrollTrigger.

       Two pins on this page — full-service mgmt carousel + compliance
       crossfade — both used to be CSS `position: sticky` inside a
       tall outer container. That worked for natural scrolling but
       glitched when temporarily demoted to `relative` for nav-click
       bypass (sticky and relative position the element to different
       spots, so the demote moment caused a visible jump).

       ScrollTrigger pins differently:
         1. Wraps the pin target in a `pin-spacer` of the right height
            so subsequent content doesn't shift up.
         2. While the pin range is active, sets `position: fixed` on
            the target so it visually holds at the top of the viewport.
         3. Calls `onUpdate(self)` every scroll tick with `self.progress`
            (0..1 across the pin range) — we read that and apply our
            scroll-driven animations.
         4. Handles fast scrolls + programmatic `lenis.scrollTo()`
            without the flash.

       GSAP/ScrollTrigger are registered in BaseLayout; we import
       them again here and Vite dedupes the bundle. */}
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    function easeInOutCubic(t) {
      return t < 0.5
        ? 4 * t * t * t
        : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    /* ── Full-service mgmt carousel pin ───────────────────────────
       Trigger: `.mp-included-pin` (the wrapper around the header +
       carousel). Pin target: `.mp-included-pin__viewport` (the
       inner element that holds the visible content). Pin scroll
       budget: 300vh (~3 viewport-heights of vertical scroll while
       pinned) — enough to advance through 4 slides comfortably,
       not so much that scrolling through feels endless. */
    (function setupCarouselPin() {
      const pin = document.querySelector('.mp-included-pin');
      if (!pin) return;
      const viewport = pin.querySelector('.mp-included-pin__viewport');
      const track = pin.querySelector('[data-prop-track]');
      const slides = Array.from(pin.querySelectorAll('.mp-prop-slide'));
      const dots = Array.from(pin.querySelectorAll('[data-prop-page]'));
      if (!viewport || !track || !slides.length) return;

      // Opt out of pinning on small viewports — the carousel reverts
      // to native scroll-snap behavior there (see the mobile CSS
      // override block above). The ScrollTrigger.matchMedia API
      // would also work but a simple gate is cleaner here.
      const mobileQuery = window.matchMedia('(max-width: 720px)');
      if (mobileQuery.matches) return;

      ScrollTrigger.create({
        trigger: pin,
        // Pin starts when the pin element's top reaches the bottom
        // edge of the mp-nav (64px from viewport top).
        start: 'top top+=64',
        end: '+=300vh',
        pin: viewport,
        // `pinSpacing: true` reserves the scroll budget below the
        // pin so subsequent content doesn't slide up underneath.
        pinSpacing: true,
        // `scrub: 0.4` lerps animation to scroll position with
        // ~0.4s lag — the codebase default for "smooth but
        // responsive" scroll-driven motion.
        scrub: 0.4,
        // `fastScrollEnd: true` ensures the animation snaps to its
        // final state if the user scrolls so fast that ScrollTrigger
        // would otherwise lag behind.
        fastScrollEnd: true,
        // `anticipatePin: 1` gives the pin a tiny head-start to
        // engage before the user reaches the trigger point, which
        // avoids a momentary flicker on fast scroll.
        anticipatePin: 1,
        onUpdate: (self) => {
          const progress = self.progress;
          const trackWidth = track.scrollWidth;
          const viewportW = viewport.clientWidth || track.parentElement.clientWidth;
          const maxHorizontal = Math.max(0, trackWidth - viewportW);
          track.style.transform = `translate3d(-${(progress * maxHorizontal).toFixed(2)}px, 0, 0)`;

          // Update the active dot based on which slide is most centered.
          if (dots.length) {
            const centerX = (progress * maxHorizontal) + viewportW / 2;
            let closest = 0;
            let closestDist = Infinity;
            slides.forEach((s, i) => {
              const slideCenter = s.offsetLeft + s.clientWidth / 2;
              const dist = Math.abs(centerX - slideCenter);
              if (dist < closestDist) { closestDist = dist; closest = i; }
            });
            dots.forEach((d) => {
              d.classList.toggle('is-active', parseInt(d.getAttribute('data-prop-page'), 10) === closest);
            });
          }
        },
      });
    })();

    /* Compliance crossfade was migrated back to a simple
       IntersectionObserver + CSS class. The ScrollTrigger pin
       approach had a layout-shift glitch on kill that we couldn't
       fully smooth out without other tradeoffs. The class-toggle
       version is short and reliable — see the inline script
       further down. */
  </script>

  {/* ────────────────────────────────────────────────────────────────
       "Every visit includes" — scroll-driven pill→heading reveal.
       Sets a CSS custom property `--reveal` (0..1) on the section
       based on how far it has scrolled into the viewport. CSS rules
       above interpolate font-size / padding / background / opacity
       / translateY against `--reveal` to morph the pill into the
       full heading and stagger-in the description + grid.

       Animation window (relative to viewport height):
         progress 0:  section's top edge sits at 85% down the viewport
                      (the section has just started entering from the
                      bottom, the pill is small in the center)
         progress 1:  section's top edge sits at 25% down the viewport
                      (the section is mostly scrolled into view, the
                      pill has fully morphed into the heading)
       Outside that window we clamp to 0 or 1.

       Respects prefers-reduced-motion — if the user has asked for
       reduced motion, we skip the scroll listener entirely and pin
       `--reveal` at 1, so the section just renders in its final
       state without any animation. */}
  <script>
    (function () {
      const section = document.querySelector('[data-included-reveal]');
      if (!section) return;

      // Reduced-motion: skip animation, show final state immediately.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        section.style.setProperty('--reveal', '1');
        return;
      }

      // Boundary positions as fractions of viewport height. Tweak these
      // to make the animation start / finish at different points in the
      // scroll. The DIFFERENCE between startTop and endTop is the scroll
      // "duration" — how many viewport-heights of scrolling it takes to
      // play the full animation. With 1.0 → 0.0 the animation plays out
      // over exactly one viewport-height of scroll, which is the natural
      // budget the 100vh-tall shell gives us. (Was 0.85 → 0.25 = 0.6vh
      // of scroll, which felt rushed for the pill rise + expand sequence.) */
      const startTop = 1.0;
      const endTop = 0.0;

      // easeInOutCubic — same curve used by countless UI animations.
      // Output:
      //   t = 0 → 0
      //   t = 0.5 → 0.5 (passes through center linearly)
      //   t = 1 → 1
      // But the slope is SHALLOW near t=0 and t=1, and STEEP near t=0.5.
      // Applied to scroll-driven progress, that means the animation
      // starts and ends gently, with the bulk of the visual change
      // happening through the middle of the scroll range. Reads as
      // "eased" instead of mechanically tied to scroll speed.
      function easeInOutCubic(t) {
        return t < 0.5
          ? 4 * t * t * t
          : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      let ticking = false;
      function update() {
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        // `topRatio` = where the section's top edge is in the viewport,
        // expressed as a fraction (0 = top of viewport, 1 = bottom).
        const topRatio = rect.top / vh;
        // Map [startTop, endTop] → [0, 1] (linear progress).
        let progress = (startTop - topRatio) / (startTop - endTop);
        if (progress < 0) progress = 0;
        if (progress > 1) progress = 1;
        // Apply easing curve so the pill rise + expand reads as
        // smoothed-out rather than mechanically scroll-locked. Both
        // sub-phases (--rise and --expand in CSS) inherit the eased
        // curve since they're calc()s of --reveal.
        const eased = easeInOutCubic(progress);
        section.style.setProperty('--reveal', eased.toFixed(3));
        ticking = false;
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update(); // initial state on page load
    })();
  </script>

  {/* ────────────────────────────────────────────────────────────────
       "Every visit includes" — slidable tape of 4 columns × 2 cards,
       with only 3 columns visible at a time inside a clipping viewport.
       Two pages of 3 visible columns each:
         page 0 → tape at translateX(0)        → cols 1–3 visible
         page 1 → tape at translateX(-1 step)  → cols 2–4 visible
       The translation step is computed from the first column's
       actual rendered width + the inter-column gap, so the slide
       lands the next column exactly flush with the viewport's left
       edge regardless of breakpoint. CSS provides the spring easing
       via `cubic-bezier(0.34, 1.56, 0.64, 1)` (easeOutBack), which
       gives the soft overshoot that reads as a spring settle. */}
  <script>
    (function () {
      const grid = document.querySelector('[data-included-grid]');
      if (!grid) return;
      const tape = grid.querySelector('[data-included-tape]');
      const cols = tape ? Array.from(tape.querySelectorAll('.mp-grid__col')) : [];
      const dots = document.querySelectorAll('[data-included-page]');
      const prev = document.querySelector('[data-included-prev]');
      const next = document.querySelector('[data-included-next]');
      const PAGES = 2;
      let page = 0;

      // Step = column width + gap. Measure at apply-time so the
      // carousel survives resize and the mobile→desktop layout swap.
      function getStep() {
        if (!cols.length) return 0;
        const gap = parseFloat(getComputedStyle(tape).columnGap || getComputedStyle(tape).gap) || 0;
        return cols[0].offsetWidth + gap;
      }

      function render() {
        if (tape) {
          const offset = page * getStep();
          tape.style.transform = `translateX(-${offset}px)`;
        }
        dots.forEach((d) => {
          d.classList.toggle('is-active', parseInt(d.getAttribute('data-included-page'), 10) === page);
        });
        if (prev) prev.disabled = page === 0;
        if (next) next.disabled = page === PAGES - 1;
      }

      dots.forEach((d) => {
        d.addEventListener('click', () => {
          page = parseInt(d.getAttribute('data-included-page'), 10);
          render();
        });
      });
      if (prev) prev.addEventListener('click', () => { if (page > 0) { page--; render(); } });
      if (next) next.addEventListener('click', () => { if (page < PAGES - 1) { page++; render(); } });

      // Re-snap on resize so the visible cols stay properly aligned
      // when the column width changes (debounced lightly).
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(render, 120);
      });

      render();
    })();
  </script>

